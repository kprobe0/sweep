  [[ "$answer" == "yes" ]]
}

menu_clean_selected() {
  local n kb label path how sum ticked
  [[ -s "$MENU_DIR/selpaths" ]] || {
    NOTE="Tick a number first."
    return 0
  }
  printf '\n  This will delete:\n'
  sum=0
  ticked=0
  while IFS=$'\t' read -r n kb plain label path how group; do
    path_selected "$path" || continue
    ticked=$((ticked + 1))
    sum=$((sum + kb))
    if [[ "$ticked" -le 8 ]]; then
      if app_is_open "$path"; then
        printf '    %10s    %s  (app is open)\n' "$(human "$kb")" "$plain"
      else
        printf '    %10s    %s\n' "$(human "$kb")" "$plain"
      fi
    fi
  done <"$MENU_DIR/items"
  if [[ "$ticked" -gt 8 ]]; then
    printf '    and %s more\n' "$((ticked - 8))"
