menu_all_safe() {
  local group
  printf '\n  This clears caches, Homebrew, dev tools, Xcode build data,\n'
  printf '  app caches, old logs, Quick Look, and the Trash.\n'
  printf '  That removal is permanent. Backups, browsers, and device files stay.\n'
