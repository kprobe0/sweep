    [[ "$gained" -lt 0 ]] && gained=0
    forget_catalog
    if [[ "$gained" -gt 0 ]]; then
      NOTE="Removed about $(human "$gained"). $(human "$before") free before, $(human "$after") free now.$(snapshot_clause)"
    else
      NOTE="Deleted. $(human "$after") free now.$(snapshot_clause)"
    fi
    PAGE=1
  else
    NOTE="Kept. Nothing was deleted."
  fi
