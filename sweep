    apps) printf 'The app builds this cache again.' ;;
    logs) printf 'Old log files. Crash reports are not in this list.' ;;
    quicklook) printf 'Finder thumbnail pictures. Finder makes them again.' ;;
    browsers) printf 'The browser reloads these pages. Cookies stay.' ;;
    backups) printf 'This is a device backup. Deleting it cannot be undone.' ;;
    devices) printf 'Rebuilt the next time you plug that device in.' ;;
    archives) printf 'An old Xcode export. This exact file will not come back.' ;;
    projects) printf 'Build files. The next build creates them again.' ;;
