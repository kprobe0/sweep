menu_walk() {
  local scope="$1" kb plain label path how group answer freed n capped total
  ensure_catalog
  freed=0
  n=0
  capped=0
  total=0
  local before_free
  before_free="$(disk_free_kb)"
  while IFS=$'\t' read -r kb plain label path how group <&4; do
    [[ -n "$path" ]] || continue
    if ! walk_includes "$scope" "$group"; then
      continue
    fi
    [[ "$kb" -lt "$MIN_KB" ]] && continue
    total=$((total + 1))
  done 4<"$MENU_DIR/catalog"
  while IFS=$'\t' read -r kb plain label path how group <&4; do
    [[ -n "$path" ]] || continue
    if ! walk_includes "$scope" "$group"; then
      continue
    fi
    if [[ "$kb" -lt "$MIN_KB" ]]; then
      continue
    fi
    if [[ "$n" -ge 12 ]]; then
      capped=1
      break
    fi
    n=$((n + 1))
    menu_blank
    print_disk
    printf '\n  %s%s%s\n' "$B" "$plain" "$Z"
    printf '  %s of %s\n' "$n" "$total"
    printf '  %s\n' "$(human "$kb")"
    printf '  %s\n' "$(why_item "$group")"
    if app_is_open "$path"; then
      printf '  This app is open. Quit it first if you can.\n'
    fi
    printf '\n'
    printf '  yes    delete it for good\n'
    printf '  no     keep it and show the next one\n'
    printf '  quit   stop here\n'
    printf '  > '
    IFS= read -r answer || exit 0
    answer="${answer//$'\r'/}"
    case "$answer" in
      yes)
        delete_item "$how" "$path"
        freed=$((freed + kb))
        ;;
      quit|q|exit)
        break
        ;;
    esac
  done 4<"$MENU_DIR/catalog"
  forget_catalog
  SCREEN="home"
  PAGE=1
  if [[ "$n" -eq 0 ]]; then
    NOTE="Nothing safe to walk through."
  elif [[ "$freed" -gt 0 && "$capped" -eq 1 ]]; then
    NOTE="Removed about $(human "$freed"). $(human "$before_free") free before, $(human "$(disk_free_kb)") free now.$(snapshot_clause) Type walk for the next folders."
  elif [[ "$freed" -gt 0 ]]; then
    NOTE="Removed about $(human "$freed"). $(human "$before_free") free before, $(human "$(disk_free_kb)") free now.$(snapshot_clause)"
  else
    NOTE="Nothing was deleted."
  fi
}

menu_pause() {
  printf '  Press return to go back.\n  > '
  IFS= read -r _ || exit 0
}

menu_info() {
  local word="$1" n kb plain label path how group found base word_care
  found=0
  [[ -f "$MENU_DIR/items" ]] || {
    NOTE="Open the list first."
    return 0
  }
  while IFS=$'\t' read -r n kb plain label path how group; do
    base="$(basename "$path")"
    if [[ "$word" == "$n" || "$(fold_case "$word")" == "$(fold_case "$plain")" || "$word" == "$label" || "$word" == "$base" ]]; then
      found=1
      printf '\n  %s%s%s\n' "$B" "$plain" "$Z"
      word_care="$(care_word "$group")"
      if [[ "$word_care" == "ask first" && "$(fate_word "$group")" == "stays" ]]; then
        word_care="stays"
      fi
      printf '  %s, %s\n' "$(human "$kb")" "$word_care"
      printf '  %s\n' "$(why_item "$group")"
      if [[ "$group" == "orphans" || "$group" == "gone" ]]; then
        local bid embedded
        bid="$(basename "$path")"
        embedded="$(container_bundle_id "$bid" || true)"
        [[ -n "$embedded" ]] && bid="$embedded"
        printf '  %s\n' "$bid"
        printf '  Unused for %s days.\n' "$(path_age_days "$path")"
        if id_is_installed "$bid" "$(installed_ids)"; then
          printf '  An installed app still owns it.\n'
        else
          printf '  No installed app owns it.\n'
        fi
      fi
      if [[ "$path" != "-" && "$path" != sim:* ]]; then
        printf '  %s\n' "${path#"$SWEEP_HOME"/}"
      fi
      if app_is_open "$path"; then
        printf '  This app is open.\n'
      fi
      printf '\n'
      break
    fi
  done <"$MENU_DIR/items"
  if [[ "$found" -eq 0 ]]; then
    NOTE="No line named \"$word\"."
    return 0
  fi
  menu_pause
}

menu_show_last() {
  printf '\n'
  cmd_last
  menu_pause
}

menu_login() {
  local plist prog base n answer target num saved
  printf '\n  Login helpers whose program is already gone. Nothing is selected.\n'
  printf '  A helper that still exists is left alone.\n'
  n=0
  : >"$MENU_DIR/logins"
  if [[ -d "$SWEEP_HOME/Library/LaunchAgents" ]]; then
    for plist in "$SWEEP_HOME/Library/LaunchAgents"/*.plist; do
      [[ -f "$plist" ]] || continue
      prog="$(launch_program "$plist")"
      [[ -n "$prog" ]] || continue
      if [[ -e "$prog" ]]; then
        continue
      fi
      n=$((n + 1))
      base="$(basename "$plist")"
      printf '  %2d  %s\n    missing %s\n' "$n" "$base" "$prog"
      printf '%s\t%s\n' "$n" "$base" >>"$MENU_DIR/logins"
    done
  fi
  show_other_logins
  if [[ "$n" -eq 0 ]]; then
    printf '  No user login helpers with a missing program.\n'
    menu_pause
    return 0
  fi
  printf '  Type a number, or press return.\n  > '
  IFS= read -r answer || exit 0
  answer="${answer//$'\r'/}"
  [[ -n "$answer" ]] || return 0
  target=""
  while IFS=$'\t' read -r num base; do
    [[ "$num" == "$answer" ]] && target="$base"
  done <"$MENU_DIR/logins"
  if [[ -z "$target" ]]; then
    NOTE="No helper numbered $answer."
    return 0
  fi
  printf '  Remove %s? This is permanent.\n' "$target"
  printf '  Type yes to remove it, or press return to cancel.\n'
  if menu_confirm_yes; then
    saved="$DRY"
    DRY=0
    cmd_login remove "$target"
    DRY="$saved"
  fi
  menu_pause
}

menu_uninstall() {
  local app n answer picked name num saved
  printf '\n  Installed apps. Nothing is moved until you type yes.\n'
  n=0
  : >"$MENU_DIR/apps"
  while IFS= read -r app; do
    [[ -n "$app" ]] || continue
    n=$((n + 1))
    printf '  %2d  %s\n' "$n" "$(basename "$app" .app)"
    printf '%s\t%s\n' "$n" "$app" >>"$MENU_DIR/apps"
  done < <(each_app)
  if [[ "$n" -eq 0 ]]; then
    printf '  None.\n'
    menu_pause
    return 0
  fi
  printf '  Type a number. Leftovers stay unticked.\n  > '
  IFS= read -r answer || exit 0
  answer="${answer//$'\r'/}"
  [[ -n "$answer" ]] || return 0
  picked=""
  while IFS=$'\t' read -r num app; do
    [[ "$num" == "$answer" ]] && picked="$app"
  done <"$MENU_DIR/apps"
  if [[ -z "$picked" ]]; then
    NOTE="No app numbered $answer."
    return 0
  fi
  name="$(basename "$picked" .app)"
  saved="$DRY"
  DRY=1
  UNINSTALL_LEFTOVERS=0
  cmd_uninstall "$name"
  printf '  Type yes to move it to the Trash. Leftovers stay.\n'
  if menu_confirm_yes; then
    DRY=0
    cmd_uninstall "$name" move
  else
    printf '  Kept.\n'
  fi
  DRY="$saved"
  menu_pause
}

menu_handle_word() {
  local word="$1"
  case "$word" in
    quit|q|exit)
      printf '  Bye.\n'
      exit 0
      ;;
    help|\?)
      if [[ "$SHOW_HELP" -eq 1 ]]; then
        SHOW_HELP=0
      else
        SHOW_HELP=1
      fi
      return 0
      ;;
    info)
      NOTE="Type info and a number. Example: info 1"
      return 0
      ;;
    last)
      menu_show_last
      return 0
      ;;
    login)
      menu_login
      return 0
      ;;
    uninstall)
      menu_uninstall
      return 0
      ;;
    orphans)
      cmd_orphans
      menu_pause
      return 0
      ;;
    large)
      [[ "$SCREEN" == "home" ]] || return 1
      cmd_large
      printf '  Press return to go back.\n  > '
      IFS= read -r _ || exit 0
      return 0
      ;;
    groups)
      SCREEN="groups"
      PAGE=1
      FILTER=""
      return 0
      ;;
    back|home)
      [[ "$SCREEN" == "home" ]] && return 1
      SCREEN="home"
      PAGE=1
      FILTER=""
      return 0
      ;;
    more|next)
      PAGE=$((PAGE + 1))
      return 0
      ;;
    prev)
      [[ "$PAGE" -gt 1 ]] && PAGE=$((PAGE - 1))
      return 0
      ;;
    show)
      FILTER=""
      PAGE=1
      return 0
      ;;
    safe)
      menu_all_safe
      return 0
      ;;
    walk)
      menu_walk safe
      return 0
      ;;
    go)
      if [[ "$SCREEN" != "home" ]]; then
        NOTE="Type go from the first list."
        return 0
      fi
      local stays_left
      stays_left="$(menu_stays_names)"
      menu_select_safe
      if [[ ! -s "$MENU_DIR/selpaths" ]]; then
        if [[ -n "$OPEN_LEFT" ]]; then
          NOTE="Left because the app is open: $OPEN_LEFT. Quit it, or tick the line and type clean."
        else
          NOTE="Nothing safe to remove."
        fi
        if [[ -n "$stays_left" ]]; then
          NOTE="$NOTE Left unticked: $stays_left."
        fi
        return 0
      fi
      menu_clean_selected
      if [[ -n "$OPEN_LEFT" ]]; then
        NOTE="$NOTE Left because the app is open: $OPEN_LEFT."
      fi
      if [[ -n "$stays_left" ]]; then
        NOTE="$NOTE Left unticked: $stays_left."
      fi
      return 0
      ;;
    small)
      if [[ "$SHOW_SMALL" -eq 1 ]]; then
        SHOW_SMALL=0
      else
        SHOW_SMALL=1
      fi
      PAGE=1
      return 0
      ;;
    all)
      if [[ "$SCREEN" == "home" ]]; then
        menu_select_safe
      elif [[ "$SCREEN" == "groups" ]]; then
        menu_all_safe
      else
        menu_select_all
      fi
      return 0
      ;;
    none)
      : >"$MENU_DIR/selpaths"
      return 0
      ;;
    clean)
      if [[ "$SCREEN" == "groups" ]]; then
        NOTE="Open a list first, or type safe."
        return 0
      fi
      menu_clean_selected
      return 0
      ;;
    *)
      menu_toggle_word "$word" || return 1
      ;;
  esac
}

cmd_menu() {
  local reply word oldifs
  MENU_DIR="$(mktemp -d)"
  : >"$MENU_DIR/selpaths"
  SCREEN="home"
  PAGE=1
  FILTER=""
  while true; do
    if [[ "$SCREEN" == "home" ]]; then
      menu_draw_home
    elif [[ "$SCREEN" == "groups" ]]; then
      menu_draw_groups
    else
      menu_draw_group "$GROUP"
    fi
    printf '  > '
    IFS= read -r reply || break
    reply="${reply//$'\r'/}"
    [[ -n "$reply" ]] || continue
    set -f
    oldifs="$IFS"
    IFS=' '
    # shellcheck disable=SC2086
    set -- $reply
    IFS="$oldifs"
    set +f
    if [[ "$1" == "find" && $# -ge 2 ]]; then
      FILTER="$2"
      PAGE=1
      continue
    fi
    if [[ "$1" == "info" && $# -ge 2 ]]; then
      menu_info "$2"
      continue
    fi
    if [[ $# -ge 2 && "$1" == "walk" && "$2" == "all" ]]; then
      menu_walk all
      continue
    fi
    if [[ $# -ge 2 && "$1" == "walk" && "$2" == "stays" ]]; then
      menu_walk stays
      continue
    fi
    if [[ "$1" == /* ]]; then
      FILTER="${1#/}"
      PAGE=1
      continue
    fi
    if [[ $# -eq 1 ]]; then
      if ! menu_handle_word "$1"; then
        NOTE="I do not know \"$1\". Type help."
      fi
    else
      for word in "$@"; do
        case "$word" in
          quit|q|exit|help|\?|large|back|home|all|none|clean|groups|more|next|prev|show|safe|find|walk|go|small|info|last|login|uninstall|orphans)
            NOTE="Type $word on its own line."
            ;;
          *)
            menu_toggle_word "$word" || NOTE="I do not know \"$word\"."
            ;;
        esac
      done
    fi
  done
  rm -rf "$MENU_DIR"
}

usage() {
  cat <<EOF
sweep ${VERSION} — a quiet disk cleaner for macOS

  sweep                      biggest folders, tick with a number, then yes
  sweep scan                 print the lists and exit
  sweep items caches         show folders you can tick
  sweep clean caches --only NAME --yes
                             delete one folder
  sweep clean --yes          delete every safe group
  sweep large                biggest folders, look only
  sweep orphans              leftovers unused for 30 days. Nothing is selected
  sweep orphans remove ID --yes
  sweep uninstall Name       preview one app. It moves to the Trash after --yes
  sweep uninstall restore Name
                             put that app back while it is still in the Trash
  sweep last all             the whole removal receipt
  sweep clean homebrew --empty --yes
                             the whole Homebrew cache, not only 120 days

In the menu, type walk to answer yes or no for one folder at a time.
Or tick lines with a number or a name, then clean, then the word yes.

Safe groups, included in "all" and "sweep clean --yes":
  caches homebrew dev xcode apps quicklook logs trash

Named groups, never included unless you open them:
  browsers archives devices simulators docker backups projects downloads partial files

Nothing here frees RAM, scans for viruses, or phones home.
Documents, Desktop, Photos, Mail, Messages, and Preferences are never deleted.
iPhone backups are deleted only if you open backups and tick them.

EOF
}

if [[ $# -eq 0 ]]; then
  AUTO_MENU=1
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    scan|clean|large|help|menu|items|last|login|uninstall|orphans)
      CMD="$1"
      ;;
    projects)
      if [[ "$CMD" == "scan" && -z "$PICKS" ]]; then
        CMD="projects"
      else
        known_group "$1" || die "unknown group: $1"
        PICKS="${PICKS:+$PICKS }$1"
      fi
      ;;
    --yes|-y)
      DRY=0
      ;;
    --only)
      shift
      [[ $# -gt 0 ]] || die "--only needs the folder name"
      ONLY="${ONLY}"$'\n'"$1"
      ;;
    --leftovers)
      UNINSTALL_LEFTOVERS=1
      ;;
    --empty)
      HOMEBREW_EMPTY=1
      ;;
    --dry-run)
      DRY=1
      ;;
    --version|-V)
      printf '%s\n' "$VERSION"
      exit 0
      ;;
    -h|--help)
      CMD="help"
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      if [[ "$CMD" == "last" && "$1" == "all" ]]; then
        EXTRA="all"
      elif [[ "$CMD" == "login" || "$CMD" == "uninstall" || "$CMD" == "orphans" ]]; then
        EXTRA="${EXTRA:+$EXTRA }$1"
      else
        known_group "$1" || die "unknown group: $1"
        PICKS="${PICKS:+$PICKS }$1"
      fi
      ;;
  esac
  shift
done

case "$CMD" in
  scan)
    if [[ "$AUTO_MENU" -eq 1 && ( -n "${SWEEP_MENU:-}" || ( -t 0 && -t 1 ) ) ]]; then
      cmd_menu
    else
      cmd_scan
    fi
    ;;
  menu) cmd_menu ;;
  last) cmd_last "${EXTRA:-}" ;;
  login)
    set -f
    # shellcheck disable=SC2086
    set -- $EXTRA
    set +f
    cmd_login "${1:-}" "${2:-}"
    ;;
  uninstall)
    set -f
    # shellcheck disable=SC2086
    set -- $EXTRA
    set +f
    cmd_uninstall "${1:-}" "${2:-}"
    ;;
  orphans)
    set -f
    # shellcheck disable=SC2086
    set -- $EXTRA
    set +f
    cmd_orphans "${1:-}" "${2:-}"
    ;;
  items) cmd_items ;;
  clean) cmd_clean ;;
  projects) cmd_projects ;;
  large) cmd_large ;;
  help) usage ;;
esac
