menu_toggle_word() {
  local word="$1" n kb plain label path how group base hits first
  if [[ "$SCREEN" == "groups" ]]; then
    [[ -f "$MENU_DIR/home" ]] || return 1
    while IFS=$'\t' read -r n group kb; do
      if [[ "$word" == "$n" || "$word" == "$group" ]]; then
        menu_open_group "$group"
        return 0
      fi
    done <"$MENU_DIR/home"
    return 1
  fi
  if [[ "$SCREEN" == "home" ]] && known_group "$word"; then
    menu_open_group "$word"
    return 0
  fi
  [[ -f "$MENU_DIR/items" ]] || return 1
  hits=0
  first=""
  while IFS=$'\t' read -r n kb plain label path how group; do
    base="$(basename "$path")"
    if [[ "$word" == "$n" ]]; then
      toggle_path "$path"
      return 0
    fi
    if [[ "$(fold_case "$word")" == "$(fold_case "$plain")" || "$word" == "$label" || "$word" == "$base" ]]; then
      hits=$((hits + 1))
      first="$path"
    fi
  done <"$MENU_DIR/items"
  if [[ "$hits" -eq 1 ]]; then
    toggle_path "$first"
    return 0
  fi
  if [[ "$hits" -gt 1 ]]; then
    NOTE="Several lines match \"$word\". Type the number."
    return 0
  fi
  return 1
}

