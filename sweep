#!/bin/bash
# sweep — a quiet disk cleaner for macOS.
# Deletes regenerable caches. Leaves your files alone unless you name them.
# Nothing is removed unless you pass --yes.

VERSION=0.15.0

set -euo pipefail
shopt -s nullglob

if [[ "$(uname -s)" != "Darwin" && -z "${SWEEP_TEST:-}" ]]; then
  printf 'sweep is for macOS.\n' >&2
  exit 1
fi

if [[ "$(id -u)" -eq 0 ]]; then
  printf 'Run sweep as your user, not root.\n' >&2
  exit 1
fi

if [[ -n "${SWEEP_TEST:-}" ]]; then
  SWEEP_HOME="${SWEEP_HOME:-$HOME}"
else
  SWEEP_HOME="$HOME"
fi
LOG_DAYS="${SWEEP_LOG_DAYS:-7}"
if [[ -n "${SWEEP_MIN_KB+x}" ]]; then
  MIN_KB="$SWEEP_MIN_KB"
elif [[ -n "${SWEEP_TEST:-}" ]]; then
  MIN_KB=0
else
  MIN_KB=1024
fi
DRY=1
UNINSTALL_LEFTOVERS=0
HOMEBREW_EMPTY=0
HOMEBREW_PRUNE_DAYS=120
RECEIPT_KEEP="${SWEEP_RECEIPT_KEEP:-400}"
EXTRA=""
CMD="scan"
PICKS=""
ONLY=""

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  B=$'\033[1m'
  D=$'\033[2m'
  G=$'\033[32m'
  Y=$'\033[33m'
  Z=$'\033[0m'
else
  B=""
  D=""
  G=""
  Y=""
  Z=""
fi

die() {
  printf 'sweep: %s\n' "$*" >&2
  exit 1
}

find_x() {
  local root="$1"
  shift
  if [[ "$(uname -s)" == "Darwin" ]]; then
    find -x "$root" "$@"
  else
    find "$root" -xdev "$@"
  fi
}

du_depth() {
  local dir="$1"
  if [[ "$(uname -s)" == "Darwin" ]]; then
    du -xd 1 "$dir"
  else
    du -x --max-depth=1 "$dir"
  fi
}

status() {
  if [[ -t 2 ]]; then
    printf '\r\033[2m  %-48s\033[0m' "$1" >&2
  fi
}

clear_status() {
  if [[ -t 2 ]]; then
    printf '\r\033[K' >&2
  fi
}

physical() {
  python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"
}

under() {
  local parent child
  parent="$(physical "$1")"
  child="$(physical "$2")"
  [[ "$child" == "$parent" || "$child" == "$parent"/* ]]
}

is_dataless() {
  local flags
  flags="$(ls -ldO "$1" 2>/dev/null || true)"
  case "$flags" in
    *dataless*) return 0 ;;
  esac
  return 1
}

shares_bytes() {
  local path="$1" n found
  if [[ -f "$path" && ! -L "$path" ]]; then
    n="$(stat -f %l "$path" 2>/dev/null || printf '1')"
    [[ "${n:-1}" -gt 1 ]]
    return
  fi
  [[ -d "$path" && ! -L "$path" ]] || return 1
  found="$(find_x "$path" -type f -links +1 -print 2>/dev/null | awk 'NR==1 { print; exit }' || true)"
  [[ -n "$found" ]]
}

already_noted() {
  local path="$1" file
  file="${SWEEP_UNREADABLE_FILE:-/tmp/sweep-unreadable-$$}"
  if [[ -f "$file" ]] && grep -F -x -q -- "$path" "$file"; then
    return 0
  fi
  printf '%s\n' "$path" >>"$file"
  return 1
}

kb_of() {
  local path="$1" line k err
  if [[ ! -e "$path" && ! -L "$path" ]]; then
    printf '0'
    return
  fi
  if is_dataless "$path"; then
    if ! already_noted "$path"; then
      printf 'Could not size %s. It is offline and sweep will not download it.\n' "${path#"$SWEEP_HOME"/}" >&2
    fi
    printf '0'
    return
  fi
  err="$(mktemp)"
  line="$(du -sk "$path" 2>"$err" | awk '{ print $1; exit }' || true)"
  if [[ -s "$err" ]] && ! already_noted "$path"; then
    printf 'Could not read %s\n' "${path#"$SWEEP_HOME"/}" >&2
  fi
  rm -f "$err"
  k="${line:-0}"
  case "$k" in
    ''|*[!0-9]*) k=0 ;;
  esac
  printf '%s' "$k"
}

human() {
  awk -v k="${1:-0}" 'BEGIN {
    if (k+0 < 0) k = 0
    split("KB MB GB TB PB", u, " ")
    if (k < 10) { printf "%d KB", k; exit }
    v = k
    i = 1
    while (v >= 1024 && i < 5) { v /= 1024; i++ }
    printf "%.1f %s", v, u[i]
  }'
}

protected() {
  local path home
  path="$(physical "$1")"
  home="$(physical "$SWEEP_HOME")"
  case "$path" in
    "$home/Documents"|"$home/Documents/"*| \
    "$home/Desktop"|"$home/Desktop/"*| \
    "$home/Pictures"|"$home/Pictures/"*| \
    "$home/Movies"|"$home/Movies/"*| \
    "$home/Music"|"$home/Music/"*| \
    "$home/.ssh"|"$home/.ssh/"*| \
    "$home/Library/Mail"|"$home/Library/Mail/"*| \
    "$home/Library/Messages"|"$home/Library/Messages/"*| \
    "$home/Library/Preferences"|"$home/Library/Preferences/"*| \
    "$home/Library/Mobile Documents"|"$home/Library/Mobile Documents/"*| \
    "$home/Library/Application Support"|"$home/Library/Application Support/"*)
      return 0
      ;;
  esac
  return 1
}

remove_one() {
  local parent="$1" path="$2"
  [[ -e "$path" || -L "$path" ]] || return 0
  if [[ -L "$path" ]]; then
    rm "$path"
    return 0
  fi
  if ! under "$parent" "$path"; then
    printf 'skipped %s\n' "$path" >&2
    return 0
  fi
  if protected "$path"; then
    printf 'skipped %s\n' "$path" >&2
    return 0
  fi
  if is_dataless "$path"; then
    printf 'skipped %s. It is offline and sweep will not download it.\n' "${path#"$SWEEP_HOME"/}" >&2
    return 0
  fi
  if shares_bytes "$path"; then
    printf 'skipped %s. It shares bytes with another file, so the space may not come back.\n' "${path#"$SWEEP_HOME"/}" >&2
    return 0
  fi
  rm -rf "$path"
}

empty_dir() {
  local dir="$1" child
  [[ -d "$dir" && ! -L "$dir" ]] || return 0
  under "$SWEEP_HOME" "$dir" || die "refusing to touch $dir"
  [[ "$(physical "$dir")" == "$(physical "$SWEEP_HOME")" ]] && die "refusing to empty the home folder"
  for child in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [[ -e "$child" || -L "$child" ]] || continue
    remember_path "$child"
    remove_one "$dir" "$child"
  done
}

wipe_named() {
  local dir="$1" suffix="$2" child real
  [[ -d "$dir" && ! -L "$dir" ]] || return 0
  under "$SWEEP_HOME" "$dir" || die "refusing to touch $dir"
  real="$(physical "$dir")"
  [[ "$real" == *"/$suffix" ]] || die "refusing to touch $dir"
  for child in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [[ -e "$child" || -L "$child" ]] || continue
    remember_path "$child"
    if [[ -L "$child" ]]; then
      rm "$child"
      continue
    fi
    under "$dir" "$child" || continue
    rm -rf "$child"
  done
}

skip_cache_name() {
  case "$1" in
    CloudKit|com.apple.HomeKit|FamilyCircle|Homebrew| \
    com.apple.Safari|Firefox|BraveSoftware|company.thebrowser.Browser| \
    com.microsoft.edgemac|com.operasoftware.Opera|com.operasoftware.OperaGX| \
    com.apple.QuickLook.thumbnailcache|com.apple.QuickLook.ThumbnailsAgent| \
    com.apple.dt.Xcode|org.swift.swiftpm|pip|go-build|CocoaPods|Yarn|pnpm| \
    com.apple.akd|com.apple.accountsd|com.apple.identityservicesd)
      return 0
      ;;
  esac
  case "$1" in
    com.apple.Safari.*|*CloudKit*|*HomeKit*|*FamilyCircle*)
      return 0
      ;;
  esac
  return 1
}

cache_is_gone() {
  local base="$1" ids="$2"
  bundle_name_ok "$base" || return 1
  if id_is_installed "$base" "$ids"; then
    return 1
  fi
  return 0
}

sum_caches() {
  local root="$SWEEP_HOME/Library/Caches" child base sum sub ids total n
  sum=0
  ids="$(installed_ids)"
  [[ -d "$root" && ! -L "$root" ]] || { printf '0'; return; }
  total=0
  for child in "$root"/*; do
    [[ -e "$child" || -L "$child" ]] || continue
    total=$((total + 1))
  done
  n=0
  for child in "$root"/*; do
    [[ -e "$child" || -L "$child" ]] || continue
    n=$((n + 1))
    status "Sizing caches, $n of $total"
    base="$(basename "$child")"
    if [[ "$base" == "Google" && -d "$child" && ! -L "$child" ]]; then
      for sub in "$child"/*; do
        case "$(basename "$sub")" in
          Chrome|"Chrome Canary"|Chromium) continue ;;
        esac
        sum=$((sum + $(kb_of "$sub")))
      done
      continue
    fi
    if skip_cache_name "$base" || cache_is_gone "$base" "$ids"; then
      continue
    fi
    sum=$((sum + $(kb_of "$child")))
  done
  printf '%s' "$sum"
}

clean_caches() {
  local root="$SWEEP_HOME/Library/Caches" child base sub ids
  [[ -d "$root" && ! -L "$root" ]] || return 0
  under "$SWEEP_HOME" "$root" || die "refusing to touch $root"
  ids="$(installed_ids)"
  for child in "$root"/*; do
    base="$(basename "$child")"
    if [[ "$base" == "Google" && -d "$child" && ! -L "$child" ]]; then
      for sub in "$child"/*; do
        case "$(basename "$sub")" in
          Chrome|"Chrome Canary"|Chromium) continue ;;
        esac
        remember_path "$sub"
        remove_one "$child" "$sub"
      done
      continue
    fi
    if skip_cache_name "$base" || cache_is_gone "$base" "$ids"; then
      continue
    fi
    remember_path "$child"
    remove_one "$root" "$child"
  done
}

brew_cache_dir() {
  local cache home_real cache_real
  command -v brew >/dev/null 2>&1 || return 1
  cache="$(brew --cache 2>/dev/null || true)"
  [[ -n "$cache" ]] || return 1
  home_real="$(physical "$SWEEP_HOME")"
  cache_real="$(physical "$cache")"
  [[ "$cache_real" == "$home_real"/* ]] || return 1
  printf '%s' "$cache"
}

browser_paths() {
  local h="$SWEEP_HOME"
  printf '%s\n' \
    "$h/Library/Caches/com.apple.Safari" \
    "$h/Library/Caches/Google/Chrome" \
    "$h/Library/Caches/Google/Chrome Canary" \
    "$h/Library/Caches/Google/Chromium" \
    "$h/Library/Caches/Firefox" \
    "$h/Library/Caches/BraveSoftware" \
    "$h/Library/Caches/company.thebrowser.Browser" \
    "$h/Library/Caches/com.microsoft.edgemac" \
    "$h/Library/Caches/com.operasoftware.Opera" \
    "$h/Library/Caches/com.operasoftware.OperaGX"
}

dev_paths() {
  local h="$SWEEP_HOME"
  printf '%s\n' \
    "$h/.npm" \
    "$h/.cache/pip" \
    "$h/Library/Caches/pip" \
    "$h/.cache/uv" \
    "$h/.yarn/cache" \
    "$h/Library/Caches/Yarn" \
    "$h/Library/Caches/pnpm" \
    "$h/.cargo/registry/cache" \
    "$h/.cargo/registry/src" \
    "$h/.cargo/git/checkouts" \
    "$h/Library/Caches/go-build" \
    "$h/.cache/go-build" \
    "$h/.gradle/caches" \
    "$h/Library/Caches/CocoaPods" \
    "$h/Library/Caches/org.carthage.CarthageKit" \
    "$h/Library/Caches/zig" \
    "$h/.cache/swift-package-manager"
}

xcode_paths() {
  local h="$SWEEP_HOME"
  printf '%s\n' \
    "$h/Library/Developer/Xcode/DerivedData" \
    "$h/Library/Developer/CoreSimulator/Caches" \
    "$h/Library/Caches/com.apple.dt.Xcode" \
    "$h/Library/Caches/org.swift.swiftpm"
}

device_paths() {
  local h="$SWEEP_HOME/Library/Developer/Xcode"
  printf '%s\n' \
    "$h/iOS DeviceSupport" \
    "$h/watchOS DeviceSupport" \
    "$h/tvOS DeviceSupport" \
    "$h/visionOS DeviceSupport"
}

app_paths() {
  local h="$SWEEP_HOME/Library/Application Support" app leaf
  for app in Code "Code - Insiders" Cursor Slack discord Discord "Microsoft Teams" Figma; do
    for leaf in Cache CachedData "Code Cache" GPUCache; do
      printf '%s\n' "$h/$app/$leaf"
    done
  done
}

quicklook_paths() {
  local h="$SWEEP_HOME/Library/Caches"
  printf '%s\n' \
    "$h/com.apple.QuickLook.thumbnailcache" \
    "$h/com.apple.QuickLook.ThumbnailsAgent"
}

sum_paths() {
  local path sum
  sum=0
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    sum=$((sum + $(kb_of "$path")))
  done
  printf '%s' "$sum"
}

clean_paths() {
  local path parent
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    [[ -e "$path" || -L "$path" ]] || continue
    parent="$(dirname "$path")"
    if protected "$path"; then
      case "$(basename "$path")" in
        Cache|CachedData|GPUCache) ;;
        "Code Cache") ;;
        *)
          printf 'skipped %s\n' "$path" >&2
          continue
          ;;
      esac
      remember_path "$path"
      [[ -L "$path" ]] && { rm "$path"; continue; }
      under "$SWEEP_HOME" "$path" || continue
      rm -rf "$path"
      continue
    fi
    remember_path "$path"
    remove_one "$parent" "$path"
  done
}

each_old_log() {
  local logs="$SWEEP_HOME/Library/Logs"
  [[ -d "$logs" && ! -L "$logs" ]] || return 0
  find_x "$logs" \
    \( -path "*/DiagnosticReports" -o -path "*/DiagnosticReports/*" \) -prune -o \
    -type f -mtime +"$LOG_DAYS" -print0 2>/dev/null || true
}

logs_kb() {
  local file sum k
  sum=0
  while IFS= read -r -d '' file; do
    k="$(du -sk "$file" 2>/dev/null | awk '{print $1}')" || k=0
    sum=$((sum + ${k:-0}))
  done < <(each_old_log)
  printf '%s' "$sum"
}

clean_logs() {
  local logs="$SWEEP_HOME/Library/Logs" file
  [[ -d "$logs" && ! -L "$logs" ]] || return 0
  under "$SWEEP_HOME" "$logs" || die "refusing to touch $logs"
  while IFS= read -r -d '' file; do
    under "$logs" "$file" || continue
    remember_path "$file"
    rm -f "$file"
  done < <(each_old_log)
}

real_machine() {
  [[ "$(physical "$SWEEP_HOME")" == "$(physical "$HOME")" ]]
}

sim_capture() {
  local out pid i
  if [[ -n "${SWEEP_TEST:-}" ]]; then
    if [[ -n "${SWEEP_SIM_LIST:-}" && -f "$SWEEP_SIM_LIST" ]]; then
      cat "$SWEEP_SIM_LIST"
    fi
    return 0
  fi
  real_machine || return 0
  command -v xcrun >/dev/null 2>&1 || return 0
  out="$(mktemp)"
  xcrun simctl list devices unavailable >"$out" 2>/dev/null &
  pid=$!
  i=0
  while kill -0 "$pid" 2>/dev/null; do
    i=$((i + 1))
    if [[ "$i" -gt 40 ]]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      rm -f "$out"
      return 0
    fi
    sleep 0.25
  done
  wait "$pid" 2>/dev/null || true
  cat "$out"
  rm -f "$out"
}

each_unavailable_sim() {
  sim_capture | awk '
    / \(unavailable\)/ {
      sub(/^[[:space:]]+/, "")
      if (match($0, /\([0-9A-Fa-f-]+\) \(unavailable\)/)) {
        token = substr($0, RSTART + 1, RLENGTH)
        sub(/\).*/, "", token)
        name = substr($0, 1, RSTART - 1)
        sub(/[[:space:]]+$/, "", name)
        if (name != "" && token != "") print name "\t" token
      }
    }
  '
}

sim_count() {
  local n
  n="$(each_unavailable_sim | wc -l | tr -d ' ')"
  printf '%s' "${n:-0}"
}

docker_up() {
  real_machine || return 1
  [[ -S "$HOME/.docker/run/docker.sock" || -S /var/run/docker.sock ]]
}

docker_kb() {
  local sum
  docker_up || { printf '0'; return; }
  sum="$(
    docker system df --format '{{.Reclaimable}}' 2>/dev/null |
      awk '
        {
          if (!match($0, /[0-9.]+/)) next
          n = substr($0, RSTART, RLENGTH) + 0
          rest = substr($0, RSTART + RLENGTH)
          mult = 0
          if (rest ~ /^TB/) mult = 1024 * 1024 * 1024
          else if (rest ~ /^GB/) mult = 1024 * 1024
          else if (rest ~ /^MB/) mult = 1024
          else if (rest ~ /^KB/) mult = 1
          else if (rest ~ /^B/) mult = 0
          s += n * mult
        }
        END { printf "%.0f", s + 0 }
      '
  )" || sum=0
  printf '%s' "${sum:-0}"
}

project_rows() {
  local root="$SWEEP_HOME"
  find_x "$root" \
    \( -type d \( -name Library -o -name .Trash -o -name .git \) \) -prune -o \
    \( -type d -name node_modules \) -prune -print -o \
    \( -type d -name target \) -prune -print -o \
    \( -type d -name .build \) -prune -print -o \
    \( -type d -name .next \) -prune -print -o \
    \( -type d -name .turbo \) -prune -print -o \
    \( -type d -name __pycache__ \) -prune -print
}

project_ok() {
  local path="$1" parent name
  parent="$(dirname "$path")"
  name="$(basename "$path")"
  protected "$path" && return 1
  case "$name" in
    node_modules|.next|.turbo)
      [[ -f "$parent/package.json" ]]
      ;;
    target)
      [[ -f "$parent/Cargo.toml" ]]
      ;;
    .build)
      [[ -f "$parent/Package.swift" ]]
      ;;
    __pycache__)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

projects_kb() {
  local path sum
  sum=0
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    project_ok "$path" || continue
    sum=$((sum + $(kb_of "$path")))
  done < <(project_rows)
  printf '%s' "$sum"
}

clean_projects() {
  local path
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    project_ok "$path" || continue
    remember_path "$path"
    remove_one "$(dirname "$path")" "$path"
  done < <(project_rows)
}

measure() {
  local group="$1"
  case "$group" in
    caches) sum_caches ;;
    homebrew) homebrew_kb ;;
    dev) dev_paths | sum_paths ;;
    xcode) xcode_paths | sum_paths ;;
    apps) app_paths | sum_paths ;;
    quicklook) quicklook_paths | sum_paths ;;
    logs) logs_kb ;;
    trash) kb_of "$SWEEP_HOME/.Trash" ;;
    browsers) browser_paths | sum_paths ;;
    archives) kb_of "$SWEEP_HOME/Library/Developer/Xcode/Archives" ;;
    devices) device_paths | sum_paths ;;
    simulators) printf '0' ;;
    docker) docker_kb ;;
    backups) kb_of "$SWEEP_HOME/Library/Application Support/MobileSync/Backup" ;;
    projects) projects_kb ;;
    downloads)
      local f sum
      sum=0
      while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        sum=$((sum + $(kb_of "$f")))
      done < <(each_download)
      printf '%s' "$sum"
      ;;
    partial)
      local part psum
      psum=0
      while IFS= read -r part; do
        [[ -n "$part" ]] || continue
        psum=$((psum + $(kb_of "$part")))
      done < <(each_partial)
      printf '%s' "$psum"
      ;;
    files)
      local loose lsum
      lsum=0
      while IFS= read -r loose; do
        [[ -n "$loose" ]] || continue
        lsum=$((lsum + $(kb_of "$loose")))
      done < <(each_loose_download)
      printf '%s' "$lsum"
      ;;
    *) die "unknown group: $group" ;;
  esac
}

hint_of() {
  case "$1" in
    caches) printf 'app caches that rebuild on launch' ;;
    homebrew) printf 'downloads older than %s days' "$HOMEBREW_PRUNE_DAYS" ;;
    dev) printf 'npm, pip, cargo, go, gradle, cocoapods' ;;
    xcode) printf 'DerivedData and simulator caches' ;;
    apps) printf 'Slack, Discord, VS Code, Cursor, Figma' ;;
    quicklook) printf 'Finder thumbnail cache' ;;
    logs) printf 'files in ~/Library/Logs older than %s days' "$LOG_DAYS" ;;
    trash) printf 'files already in the Trash' ;;
    browsers) printf 'page cache only. Cookies stay put' ;;
    archives) printf 'Xcode archives of old exports' ;;
    devices) printf 'rebuilt the next time you plug the device in' ;;
    simulators) printf 'one line each. sweep clean simulators removes every unavailable one' ;;
    docker) printf 'stopped containers and dangling images' ;;
    backups) printf 'iPhone and iPad backups, gone for good' ;;
    projects) printf 'node_modules, Cargo target, Swift .build' ;;
    partial) printf 'unfinished downloads' ;;
    downloads) printf 'disk images and installer archives' ;;
    files) printf 'other files in Downloads' ;;
  esac
}

homebrew_kb() {
  local c file sum k
  c="$(brew_cache_dir || true)"
  [[ -n "$c" ]] || { printf '0'; return; }
  if [[ "$HOMEBREW_EMPTY" -eq 1 ]]; then
    kb_of "$c"
    return
  fi
  sum=0
  while IFS= read -r -d '' file; do
    k="$(du -sk "$file" 2>/dev/null | awk '{print $1}')" || k=0
    sum=$((sum + ${k:-0}))
  done < <(find_x "$c" -type f -mtime +"$HOMEBREW_PRUNE_DAYS" -print0 2>/dev/null || true)
  printf '%s' "$sum"
}

list_old_homebrew() {
  local c file kb
  c="$(brew_cache_dir || true)"
  [[ -n "$c" ]] || return 0
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    kb="$(kb_of "$file")"
    [[ "${kb:-0}" -gt 0 ]] || continue
    printf '%s\t%s\n' "$kb" "$file"
  done < <(find_x "$c" -type f -mtime +"$HOMEBREW_PRUNE_DAYS" -print 2>/dev/null || true) |
    sort -nr | awk -F '\t' 'NR <= 12 { print }' |
    while IFS=$'\t' read -r kb file; do
      [[ -n "$file" ]] || continue
      emit_item "$kb" "$(basename "$file")" "$file" path
    done
}

clean_homebrew() {
  local c file
  c="$(brew_cache_dir || true)"
  if command -v brew >/dev/null 2>&1 && [[ -n "$c" ]]; then
    if [[ "$HOMEBREW_EMPTY" -eq 1 ]]; then
      brew cleanup -s --prune=all >/dev/null
    else
      brew cleanup -s --prune="$HOMEBREW_PRUNE_DAYS" >/dev/null
    fi
  fi
  [[ -n "$c" ]] || return 0
  if [[ "$HOMEBREW_EMPTY" -eq 1 ]]; then
    empty_dir "$c"
    return 0
  fi
  while IFS= read -r -d '' file; do
    remember_path "$file"
    rm -f "$file"
  done < <(find_x "$c" -type f -mtime +"$HOMEBREW_PRUNE_DAYS" -print0 2>/dev/null || true)
}

clean_group() {
  local group="$1"
  case "$group" in
    caches) clean_caches ;;
    homebrew) clean_homebrew ;;
    dev)
      dev_paths | clean_paths
      if real_machine && command -v pnpm >/dev/null 2>&1; then
        pnpm store prune >/dev/null 2>&1 || true
      fi
      ;;
    xcode) clean_xcode ;;
    apps) app_paths | clean_paths ;;
    quicklook)
      quicklook_paths | clean_paths
      if real_machine && command -v qlmanage >/dev/null 2>&1; then
        qlmanage -r cache >/dev/null 2>&1 || true
      fi
      ;;
    logs) clean_logs ;;
    trash) empty_dir "$SWEEP_HOME/.Trash" ;;
    browsers) browser_paths | clean_paths ;;
    archives) empty_dir "$SWEEP_HOME/Library/Developer/Xcode/Archives" ;;
    devices) device_paths | clean_paths ;;
    simulators)
      real_machine || return 0
      command -v xcrun >/dev/null 2>&1 || return 0
      xcrun simctl delete unavailable >/dev/null 2>&1 || true
      ;;
    docker)
      remember_removal "$(docker_kb)" "Docker unused data"
      docker_up || return 0
      docker system prune -f >/dev/null 2>&1 || true
      ;;
    backups)
      wipe_named "$SWEEP_HOME/Library/Application Support/MobileSync/Backup" "MobileSync/Backup"
      ;;
    projects) clean_projects ;;
    downloads)
      local f
      while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        remember_path "$f"
        remove_one "$(dirname "$f")" "$f"
      done < <(each_download)
      ;;
    partial)
      local part
      while IFS= read -r part; do
        [[ -n "$part" ]] || continue
        remember_path "$part"
        remove_one "$(dirname "$part")" "$part"
      done < <(each_partial)
      ;;
    files)
      local loose
      while IFS= read -r loose; do
        [[ -n "$loose" ]] || continue
        remember_path "$loose"
        remove_one "$(dirname "$loose")" "$loose"
      done < <(each_loose_download)
      ;;
    *) die "unknown group: $group" ;;
  esac
}

DEFAULT_GROUPS="caches homebrew dev xcode apps quicklook logs trash"
OPTIONAL_GROUPS="browsers archives devices simulators docker backups projects downloads partial files"

known_group() {
  case " $DEFAULT_GROUPS $OPTIONAL_GROUPS " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

disk_line() {
  df -k "$SWEEP_HOME" | awk 'NR==2 { print $4, $3, $2 }'
}

disk_free_kb() {
  local bytes
  if command -v diskutil >/dev/null 2>&1; then
    bytes="$(diskutil info "$SWEEP_HOME" 2>/dev/null | sed -n 's/.*Container Free Space:.*(\([0-9][0-9]*\) Bytes.*/\1/p' | head -n 1)"
    if [[ -n "$bytes" ]]; then
      printf '%s' "$((bytes / 1024))"
      return 0
    fi
  fi
  df -k "$SWEEP_HOME" | awk 'NR==2 { print $4 }'
}

disk_purgeable_kb() {
  local bytes
  command -v diskutil >/dev/null 2>&1 || return 0
  bytes="$(diskutil info "$SWEEP_HOME" 2>/dev/null | sed -n 's/.*Purgeable Space:.*(\([0-9][0-9]*\) Bytes.*/\1/p' | awk 'NR==1 { print; exit }')"
  [[ -n "${bytes:-}" ]] || return 0
  printf '%s' "$((bytes / 1024))"
}

snapshot_clause() {
  local snap
  if real_machine && command -v tmutil >/dev/null 2>&1; then
    snap="$(tmutil listlocalsnapshots / 2>/dev/null | awk '/com\.apple\.TimeMachine/ { name=$0 } END { print name }')"
    snap="${snap#"${snap%%[![:space:]]*}"}"
    if [[ -n "$snap" ]]; then
      printf ' Local snapshot %s may still hold those bytes until macOS purges it.' "$snap"
    fi
  fi
}

print_disk() {
  local free used total container
  read -r free used total < <(disk_line)
  container="$(disk_free_kb)"
  printf '%s%s%s\n' "$B" "sweep" "$Z"
  if command -v diskutil >/dev/null 2>&1 && [[ "$container" != "$free" ]]; then
    printf '  %s container free    %s volume free\n' "$(human "$container")" "$(human "$free")"
  else
    printf '  %s free    %s used\n' "$(human "$free")" "$(human "$used")"
  fi
  printf '  %s%s%s\n' "$D" "$(df -h "$SWEEP_HOME" | awk 'NR==2 { print $1 }')" "$Z"
  local purge
  purge="$(disk_purgeable_kb || true)"
  if [[ -n "${purge:-}" && "$purge" -gt 0 ]]; then
    printf '  Purgeable: %s. sweep will not purge it.\n' "$(human "$purge")"
  fi
}

fate_word() {
  case "$1" in
    trash|backups|archives|downloads|partial|files|orphans|gone) printf 'stays' ;;
    *) printf 'rebuilds' ;;
  esac
}

zip_is_installer() {
  local base="$1"
  case "$base" in
    *[Ii]nstall*|*[Ss]etup*) return 0 ;;
  esac
  return 1
}

each_download() {
  local f
  for f in "$SWEEP_HOME/Downloads"/*.dmg "$SWEEP_HOME/Downloads"/*.pkg \
    "$SWEEP_HOME/Downloads"/*.mpkg "$SWEEP_HOME/Downloads"/*.iso; do
    [[ -f "$f" || -L "$f" ]] || continue
    printf '%s\n' "$f"
  done
  for f in "$SWEEP_HOME/Downloads"/*.zip; do
    [[ -f "$f" || -L "$f" ]] || continue
    zip_is_installer "$(basename "$f")" || continue
    printf '%s\n' "$f"
  done
}

each_loose_download() {
  local f base
  for f in "$SWEEP_HOME/Downloads"/*; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    base="$(basename "$f")"
    case "$base" in
      *.dmg|*.pkg|*.mpkg|*.iso|*.download|*.crdownload) continue ;;
      *.zip)
        zip_is_installer "$base" && continue
        ;;
    esac
    printf '%s\n' "$f"
  done
}

each_partial() {
  local f
  for f in "$SWEEP_HOME/Downloads"/*.download "$SWEEP_HOME/Downloads"/*.crdownload; do
    [[ -f "$f" || -L "$f" ]] || continue
    printf '%s\n' "$f"
  done
}

row() {
  local name="$1" kb="$2" hint="$3"
  [[ "${kb:-0}" -gt 0 ]] || return 0
  printf '  %-14s %10s    %s%s%s\n' "$name" "$(human "$kb")" "$D" "$hint" "$Z"
}

cmd_scan() {
  local group kb sims name udid i n path sum any_left
  print_disk
  printf '\n  %sSafe to remove%s\n' "$B" "$Z"
  local any=0
  n=0
  for group in $DEFAULT_GROUPS; do
    n=$((n + 1))
  done
  i=0
  for group in $DEFAULT_GROUPS; do
    i=$((i + 1))
    status "Measuring $i of $n: $group"
    kb="$(measure "$group")"
    clear_status
    if [[ "${kb:-0}" -gt 0 ]]; then
      row "$group" "$kb" "$(hint_of "$group")"
      any=1
    fi
  done
  [[ "$any" -eq 1 ]] || printf '  %snothing sitting in the usual caches%s\n' "$D" "$Z"

  printf '\n  %sOnly when you name them%s\n' "$B" "$Z"
  any=0
  for group in browsers archives devices docker backups partial files; do
    status "Measuring $group"
    kb="$(measure "$group")"
    clear_status
    if [[ "${kb:-0}" -gt 0 ]]; then
      row "$group" "$kb" "$(hint_of "$group")"
      any=1
    fi
  done
  status "Checking simulators"
  sims="$(sim_count)"
  clear_status
  if [[ "${sims:-0}" -gt 0 ]]; then
    printf '  %-14s %10s    %s%s%s\n' "simulators" "$sims" "$D" "$(hint_of simulators)" "$Z"
    while IFS=$'\t' read -r name udid; do
      [[ -n "$name" ]] || continue
      printf '    %s\n' "$name"
    done < <(each_unavailable_sim)
    any=1
  fi
  [[ "$any" -eq 1 ]] || printf '  %snone of the optional piles are present%s\n' "$D" "$Z"

  printf '\n  %sLeftovers unused for 30 days%s\n' "$B" "$Z"
  status "Measuring leftovers"
  sum=0
  any_left=0
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    any_left=1
    sum=$((sum + $(kb_of "$path")))
  done < <(each_orphan)
  clear_status
  if [[ "$any_left" -eq 1 ]]; then
    row "leftovers" "$sum" "not part of go"
  else
    printf '  %snone%s\n' "$D" "$Z"
  fi

  printf '\n  %sBuild folders are a separate pass.%s  sweep projects\n' "$D" "$Z"
  printf '  %sNothing was deleted.%s  sweep clean --yes\n\n' "$D" "$Z"
}

cmd_clean() {
  local group kb total before after freed
  local list="$PICKS"
  if [[ -n "$ONLY" ]]; then
    cmd_clean_only
    return
  fi
  [[ -n "$list" ]] || list="$DEFAULT_GROUPS"
  for group in $list; do
    known_group "$group" || die "unknown group: $group"
  done

  total=0
  print_disk
  printf '\n'
  for group in $list; do
    status "Measuring $group"
    kb="$(measure "$group")"
    clear_status
    if [[ "$group" == "simulators" ]]; then
      kb="$(sim_count)"
      [[ "${kb:-0}" -gt 0 ]] || continue
      printf '  %-14s %10s    %s\n' "$group" "$kb devices" "$(hint_of "$group")"
      continue
    fi
    row "$group" "$kb" "$(hint_of "$group")"
    total=$((total + kb))
  done

  if [[ "$total" -eq 0 && "$list" != *"simulators"* ]]; then
    printf '\n  Nothing to remove.\n\n'
    return 0
  fi

  if [[ "$DRY" -eq 1 ]]; then
    printf '\n  %sWould remove about %s. Pass --yes to delete it.%s\n\n' "$D" "$(human "$total")" "$Z"
    return 0
  fi

  printf '\n'
  for group in $list; do
    status "Removing $group"
    clean_group "$group"
    clear_status
  done

  after=0
  for group in $list; do
    [[ "$group" == "simulators" ]] && continue
    kb="$(measure "$group")"
    after=$((after + kb))
  done
  before="$total"
  freed=$((before - after))
  [[ "$freed" -lt 0 ]] && freed=0
  printf '  %sFreed about %s.%s\n\n' "$B" "$(human "$freed")" "$Z"
}

cmd_projects() {
  local kb
  print_disk
  printf '\n  %sBuild folders%s\n' "$B" "$Z"
  status "Looking for build folders"
  kb="$(measure projects)"
  clear_status
  if [[ "${kb:-0}" -eq 0 ]]; then
    printf '  %snone found%s\n\n' "$D" "$Z"
    return 0
  fi
  row "projects" "$kb" "$(hint_of projects)"
  printf '\n  %sNothing was deleted.%s  sweep clean projects --yes\n\n' "$D" "$Z"
}

cmd_large() {
  local dir label kb path
  print_disk
  printf '\n  %sLargest folders%s\n' "$B" "$Z"
  printf '  %sThis only looks. It does not delete.%s\n' "$D" "$Z"
  for dir in "$SWEEP_HOME" "$SWEEP_HOME/Library" "$SWEEP_HOME/Library/Application Support"; do
    [[ -d "$dir" ]] || continue
    case "$dir" in
      "$SWEEP_HOME") label="Home" ;;
      "$SWEEP_HOME/Library") label="Library" ;;
      *) label="Application Support" ;;
    esac
    printf '\n  %s%s%s\n' "$B" "$label" "$Z"
    status "Measuring $label"
    while IFS=$'\t' read -r kb path; do
      [[ -n "$path" ]] || continue
      printf '  %10s    %s\n' "$(human "$kb")" "${path#"$SWEEP_HOME"/}"
    done < <(du_depth "$dir" 2>/dev/null | awk -v root="$dir" '
      {
        size = $1
        path = $0
        sub(/^[0-9]+[[:space:]]+/, "", path)
        if (path != root && path !~ /\/Mobile Documents$/ && size ~ /^[0-9]+$/) print size "\t" path
      }
    ' | sort -nr | awk 'NR <= 8')
    clear_status
  done
  printf '\n'
}

emit_item() {
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"
}

pretty_bundle() {
  local id="$1" part prev first rest
  id="${id#com.}"
  id="${id#org.}"
  id="${id#net.}"
  id="${id#io.}"
  part="${id##*.}"
  case "$part" in
    client|mac|osx|macos|helper|desktop|agent|browser|app)
      prev="${id%.*}"
      [[ "$prev" == "$id" ]] || part="${prev##*.}"
      ;;
  esac
  first="$(printf '%s' "$part" | cut -c1 | tr '[:lower:]' '[:upper:]')"
  rest="$(printf '%s' "$part" | cut -c2-)"
  printf '%s%s' "$first" "$rest"
}

path_date() {
  python3 -c 'import os,sys,time
print(time.strftime("%Y-%m-%d", time.localtime(os.stat(sys.argv[1]).st_mtime)))' "$1"
}

path_epoch() {
  stat -f %m "$1" 2>/dev/null || printf '0'
}

backup_pretty() {
  python3 -c 'import datetime,os,plistlib,sys
root=sys.argv[1]
name=""
date=""
info=os.path.join(root,"Info.plist")
if os.path.isfile(info):
    try:
        p=plistlib.load(open(info,"rb"))
        name=p.get("Device Name") or ""
        d=p.get("Last Backup Date")
        if hasattr(d,"strftime"):
            date=d.strftime("%Y-%m-%d")
    except Exception:
        pass
if not date:
    date=datetime.date.fromtimestamp(os.stat(root).st_mtime).isoformat()
if not name:
    name="Device backup "+os.path.basename(root)[:8]
print("%s, %s" % (name, date))' "$1"
}

pretty_label() {
  local label="$1" path="$2" base parent
  base="$(basename "$path")"
  parent="$(basename "$(dirname "$path")")"
  case "$path" in
    */MobileSync/Backup/*)
      backup_pretty "$path"
      return
      ;;
    */Downloads/*)
      printf '%s' "$base"
      return
      ;;
    */.npm) printf 'npm downloads'; return ;;
    */.cache/pip|*/Library/Caches/pip) printf 'pip downloads'; return ;;
    */.cache/uv) printf 'uv downloads'; return ;;
    */.yarn/cache|*/Library/Caches/Yarn) printf 'Yarn downloads'; return ;;
    */Library/Caches/pnpm) printf 'pnpm downloads'; return ;;
    */.cargo/registry/cache) printf 'Rust downloads'; return ;;
    */.cargo/registry/src) printf 'Rust source'; return ;;
    */.cargo/git/checkouts) printf 'Rust checkouts'; return ;;
    */Caches/go-build|*/.cache/go-build) printf 'Go build cache'; return ;;
    */.gradle/caches) printf 'Gradle cache'; return ;;
    */Library/Caches/CocoaPods) printf 'CocoaPods'; return ;;
    */Library/Caches/org.carthage.CarthageKit) printf 'Carthage'; return ;;
    */Library/Caches/zig) printf 'Zig cache'; return ;;
    */.cache/swift-package-manager|*/org.swift.swiftpm) printf 'Swift packages'; return ;;
    */Xcode/DerivedData) printf 'Xcode build files'; return ;;
    */Xcode/DerivedData/*)
      local sibling best newest stamp
      best=0
      newest=""
      for sibling in "$(dirname "$path")"/*; do
        [[ -d "$sibling" && ! -L "$sibling" ]] || continue
        stamp="$(path_epoch "$sibling")"
        if [[ "$stamp" -ge "$best" ]]; then
          best="$stamp"
          newest="$sibling"
        fi
      done
      if [[ "$path" == "$newest" ]]; then
        printf '%s, %s, newest' "$(basename "$path")" "$(path_date "$path")"
      else
        printf '%s, %s' "$(basename "$path")" "$(path_date "$path")"
      fi
      return
      ;;
    */Xcode/Archives/*) printf '%s, %s' "$(basename "$path")" "$(path_date "$path")"; return ;;
    */CoreSimulator/Caches) printf 'Simulator cache'; return ;;
    */Caches/com.apple.dt.Xcode) printf 'Xcode cache'; return ;;
    */node_modules) printf 'Modules in %s' "$(basename "$(dirname "$path")")"; return ;;
    */__pycache__) printf 'Python cache in %s' "$parent"; return ;;
    */.next) printf 'Next.js build in %s' "$parent"; return ;;
    */.turbo) printf 'Turbo cache in %s' "$parent"; return ;;
    */.build) printf 'Swift build in %s' "$parent"; return ;;
  esac
  case "$base" in
    target)
      if [[ -f "$(dirname "$path")/Cargo.toml" ]]; then
        printf 'Rust build in %s' "$parent"
        return
      fi
      ;;
    Cache|CachedData|GPUCache|"Code Cache")
      case "$parent" in
        Code) printf 'VS Code cache'; return ;;
        "Code - Insiders") printf 'VS Code Insiders cache'; return ;;
        Cursor) printf 'Cursor cache'; return ;;
        *) printf '%s cache' "$parent"; return ;;
      esac
      ;;
    com.spotify.client) printf 'Spotify'; return ;;
    com.apple.helpd) printf 'Help viewer'; return ;;
    com.apple.QuickLook.thumbnailcache|com.apple.QuickLook.ThumbnailsAgent)
      printf 'Finder thumbnails'
      return
      ;;
  esac
  case "$label" in
    "iOS DeviceSupport / "*) printf 'iPhone support %s, %s' "${label#iOS DeviceSupport / }" "$(path_date "$path")"; return ;;
    "watchOS DeviceSupport / "*) printf 'Watch support %s, %s' "${label#watchOS DeviceSupport / }" "$(path_date "$path")"; return ;;
    "tvOS DeviceSupport / "*) printf 'TV support %s, %s' "${label#tvOS DeviceSupport / }" "$(path_date "$path")"; return ;;
    "visionOS DeviceSupport / "*) printf 'Vision support %s, %s' "${label#visionOS DeviceSupport / }" "$(path_date "$path")"; return ;;
    "Google/"*) printf '%s' "${label#Google/}"; return ;;
  esac
  case "$base" in
    com.*|org.*|net.*|io.*) pretty_bundle "$base"; return ;;
  esac
  printf '%s' "$label"
}

sorted_items() {
  local group="$1" kb label path how plain
  while IFS=$'\t' read -r kb label path how; do
    [[ -n "$label" ]] || continue
    plain="$(pretty_label "$label" "$path" "$group")"
    printf '%s\t%s\t%s\t%s\t%s\n' "$kb" "$plain" "$label" "$path" "$how"
  done < <(list_items "$group") | sort -nr
}

kb_old_logs_under() {
  local dir="$1" file sum k
  sum=0
  [[ -e "$dir" || -L "$dir" ]] || { printf '0'; return; }
  while IFS= read -r -d '' file; do
    k="$(du -sk "$file" 2>/dev/null | awk '{print $1}')" || k=0
    sum=$((sum + ${k:-0}))
  done < <(find_x "$dir" \
    \( -path "*/DiagnosticReports" -o -path "*/DiagnosticReports/*" \) -prune -o \
    -type f -mtime +"$LOG_DAYS" -print0 2>/dev/null || true)
  printf '%s' "$sum"
}

clean_old_logs_under() {
  local dir="$1" logs file
  logs="$SWEEP_HOME/Library/Logs"
  under "$logs" "$dir" || return 0
  while IFS= read -r -d '' file; do
    under "$logs" "$file" || continue
    rm -f "$file"
  done < <(find_x "$dir" \
    \( -path "*/DiagnosticReports" -o -path "*/DiagnosticReports/*" \) -prune -o \
    -type f -mtime +"$LOG_DAYS" -print0 2>/dev/null || true)
}

list_derived_items() {
  local dir="$1" child kb
  [[ -d "$dir" && ! -L "$dir" ]] || return 0
  for child in "$dir"/*; do
    [[ -d "$child" && ! -L "$child" ]] || continue
    kb="$(kb_of "$child")"
    [[ "${kb:-0}" -gt 0 ]] || continue
    emit_item "$kb" "$(basename "$child")" "$child" path
  done
}

clean_derived_except_newest() {
  local dir="$1" child newest best stamp
  [[ -d "$dir" && ! -L "$dir" ]] || return 0
  newest=""
  best=0
  for child in "$dir"/*; do
    [[ -d "$child" && ! -L "$child" ]] || continue
    stamp="$(path_epoch "$child")"
    if [[ "${stamp:-0}" -ge "$best" ]]; then
      best="$stamp"
      newest="$child"
    fi
  done
  for child in "$dir"/*; do
    [[ -d "$child" && ! -L "$child" ]] || continue
    [[ -n "$newest" && "$child" == "$newest" ]] && continue
    remember_path "$child"
    remove_one "$dir" "$child"
  done
}

clean_xcode() {
  local path
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    if [[ "$(basename "$path")" == "DerivedData" ]]; then
      clean_derived_except_newest "$path"
    else
      [[ -e "$path" || -L "$path" ]] || continue
      remember_path "$path"
      remove_one "$(dirname "$path")" "$path"
    fi
  done < <(xcode_paths)
}

list_cache_items() {
  local root="$SWEEP_HOME/Library/Caches" child base sub kb total n
  [[ -d "$root" && ! -L "$root" ]] || return 0
  total=0
  for child in "$root"/*; do
    [[ -e "$child" || -L "$child" ]] || continue
    total=$((total + 1))
  done
  n=0
  for child in "$root"/*; do
    [[ -e "$child" || -L "$child" ]] || continue
    n=$((n + 1))
    status "Sizing caches, $n of $total"
    base="$(basename "$child")"
    if [[ "$base" == "Google" && -d "$child" && ! -L "$child" ]]; then
      for sub in "$child"/*; do
        case "$(basename "$sub")" in
          Chrome|"Chrome Canary"|Chromium) continue ;;
        esac
        kb="$(kb_of "$sub")"
        [[ "${kb:-0}" -gt 0 ]] || continue
        emit_item "$kb" "Google/$(basename "$sub")" "$sub" path
      done
      continue
    fi
    if skip_cache_name "$base"; then
      continue
    fi
    kb="$(kb_of "$child")"
    [[ "${kb:-0}" -gt 0 ]] || continue
    emit_item "$kb" "$base" "$child" path
  done
}

list_named_paths() {
  local how="$1" path kb label
  how="${how:-path}"
  while IFS= read -r path; do
    [[ -n "$path" && ( -e "$path" || -L "$path" ) ]] || continue
    kb="$(kb_of "$path")"
    [[ "${kb:-0}" -gt 0 ]] || continue
    label="${path#"$SWEEP_HOME"/}"
    emit_item "$kb" "$label" "$path" "$how"
  done
}

list_log_items() {
  local logs="$SWEEP_HOME/Library/Logs" child base kb
  [[ -d "$logs" && ! -L "$logs" ]] || return 0
  for child in "$logs"/* "$logs"/.[!.]* "$logs"/..?*; do
    [[ -e "$child" || -L "$child" ]] || continue
    base="$(basename "$child")"
    [[ "$base" == "DiagnosticReports" ]] && continue
    kb="$(kb_old_logs_under "$child")"
    [[ "${kb:-0}" -gt 0 ]] || continue
    emit_item "$kb" "$base" "$child" logs
  done
}

list_child_items() {
  local dir="$1" how="$2" prefix="$3" child kb label
  [[ -d "$dir" && ! -L "$dir" ]] || return 0
  for child in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [[ -e "$child" || -L "$child" ]] || continue
    kb="$(kb_of "$child")"
    [[ "${kb:-0}" -gt 0 ]] || continue
    label="${prefix}$(basename "$child")"
    emit_item "$kb" "$label" "$child" "$how"
  done
}

list_items() {
  local group="$1" path kb c n
  case "$group" in
    caches) list_cache_items ;;
    homebrew) list_old_homebrew ;;
    dev) dev_paths | list_named_paths path ;;
    xcode)
      while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        if [[ "$(basename "$path")" == "DerivedData" ]]; then
          list_derived_items "$path"
        else
          printf '%s\n' "$path" | list_named_paths path
        fi
      done < <(xcode_paths)
      ;;
    apps) app_paths | list_named_paths app ;;
    quicklook) quicklook_paths | list_named_paths path ;;
    logs) list_log_items ;;
    trash) list_child_items "$SWEEP_HOME/.Trash" trash "" ;;
    browsers) browser_paths | list_named_paths path ;;
    archives)
      list_child_items "$SWEEP_HOME/Library/Developer/Xcode/Archives" path ""
      ;;
    devices)
      while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        list_child_items "$path" path "$(basename "$path") / "
      done < <(device_paths)
      ;;
    simulators)
      while IFS=$'\t' read -r n udid; do
        [[ -n "$n" && -n "$udid" ]] || continue
        emit_item 1024 "$n" "sim:$udid" simone
      done < <(each_unavailable_sim)
      ;;
    docker)
      kb="$(docker_kb)"
      [[ "${kb:-0}" -gt 0 ]] || return 0
      emit_item "$kb" "Docker unused data" "-" docker
      ;;
    backups)
      list_child_items "$SWEEP_HOME/Library/Application Support/MobileSync/Backup" backup ""
      ;;
    projects)
      while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        project_ok "$path" || continue
        kb="$(kb_of "$path")"
        [[ "${kb:-0}" -gt 0 ]] || continue
        emit_item "$kb" "${path#"$SWEEP_HOME"/}" "$path" path
      done < <(project_rows)
      ;;
    downloads)
      while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        kb="$(kb_of "$path")"
        [[ "${kb:-0}" -gt 0 ]] || continue
        emit_item "$kb" "$(basename "$path")" "$path" path
      done < <(each_download)
      ;;
    partial)
      while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        kb="$(kb_of "$path")"
        [[ "${kb:-0}" -gt 0 ]] || continue
        emit_item "$kb" "$(basename "$path")" "$path" path
      done < <(each_partial)
      ;;
    files)
      while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        kb="$(kb_of "$path")"
        [[ "${kb:-0}" -gt 0 ]] || continue
        emit_item "$kb" "$(basename "$path")" "$path" path
      done < <(each_loose_download)
      ;;
    *) die "unknown group: $group" ;;
  esac
}

delete_backup_child() {
  local path="$1" root real parent
  root="$SWEEP_HOME/Library/Application Support/MobileSync/Backup"
  [[ -e "$path" || -L "$path" ]] || return 0
  under "$root" "$path" || die "refusing to touch $path"
  real="$(physical "$path")"
  parent="$(physical "$root")"
  [[ "$real" == "$parent"/* && "$real" != "$parent" ]] || die "refusing to touch $path"
  if [[ -L "$path" ]]; then
    rm "$path"
    return 0
  fi
  rm -rf "$path"
}

delete_app_cache() {
  local path="$1"
  [[ -e "$path" || -L "$path" ]] || return 0
  under "$SWEEP_HOME" "$path" || die "refusing to touch $path"
  case "$(basename "$path")" in
    Cache|CachedData|GPUCache|"Code Cache") ;;
    *) die "refusing to touch $path" ;;
  esac
  if [[ -L "$path" ]]; then
    rm "$path"
    return 0
  fi
  rm -rf "$path"
}

receipt_file() {
  printf '%s\n' "$SWEEP_HOME/.local/share/sweep/removed.txt"
}

remember_removal() {
  local kb="$1" name="$2" path="${3:-}" file rel
  [[ "${kb:-0}" -gt 0 ]] || return 0
  [[ -n "$name" ]] || return 0
  file="$(receipt_file)"
  mkdir -p "$(dirname "$file")"
  if [[ -n "$path" ]]; then
    rel="${path#"$SWEEP_HOME"/}"
    printf '%s  %s  %s  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$(human "$kb")" "$name" "$rel" >>"$file"
  else
    printf '%s  %s  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$(human "$kb")" "$name" >>"$file"
  fi
  local keep tmp
  keep="${RECEIPT_KEEP:-400}"
  tmp="$(mktemp)"
  tail -n "$keep" "$file" >"$tmp"
  mv "$tmp" "$file"
}

remember_path() {
  local path="$1"
  [[ -e "$path" || -L "$path" ]] || return 0
  remember_removal "$(kb_of "$path")" "$(pretty_label "$(basename "$path")" "$path")" "$path"
}

app_search_roots() {
  if [[ -n "${SWEEP_TEST:-}" ]]; then
    printf '%s\n' "$SWEEP_HOME/Applications"
  else
    printf '%s\n' /Applications "$HOME/Applications"
  fi
}

bundle_id_of() {
  local plist="$1/Contents/Info.plist"
  [[ -f "$plist" ]] || return 1
  python3 -c 'import plistlib,sys
try:
    p=plistlib.load(open(sys.argv[1],"rb"))
except Exception:
    sys.exit(1)
print(p.get("CFBundleIdentifier") or "")' "$plist"
}

team_id_of() {
  local app="$1" line
  command -v codesign >/dev/null 2>&1 || return 1
  line="$(codesign -dv "$app" 2>&1 | sed -n 's/^TeamIdentifier=//p' | head -n 1)"
  [[ -n "$line" && "$line" != "not set" ]] || return 1
  printf '%s' "$line"
}

receipts_for() {
  local id="$1" pkg
  command -v pkgutil >/dev/null 2>&1 || return 0
  while IFS= read -r pkg; do
    [[ "$pkg" == "$id" || "$pkg" == "$id".* ]] || continue
    printf '%s\n' "$pkg"
  done < <(pkgutil --pkgs 2>/dev/null || true)
}

launch_program() {
  python3 -c 'import plistlib,sys
try:
    p=plistlib.load(open(sys.argv[1],"rb"))
except Exception:
    sys.exit(0)
prog=p.get("Program") or ""
if not prog:
    args=p.get("ProgramArguments") or []
    if args:
        prog=args[0]
print(prog)' "$1" 2>/dev/null || true
}

each_app() {
  local root app
  while IFS= read -r root; do
    [[ -d "$root" ]] || continue
    for app in "$root"/*.app; do
      [[ -d "$app" ]] || continue
      printf '%s\n' "$app"
    done
  done < <(app_search_roots)
}

app_copies() {
  local want="$1" app id n
  n=0
  while IFS= read -r app; do
    id="$(bundle_id_of "$app" || true)"
    [[ "$id" == "$want" ]] || continue
    n=$((n + 1))
  done < <(each_app)
  printf '%s' "$n"
}

leftover_paths() {
  local id="$1" p
  for p in \
    "$SWEEP_HOME/Library/Caches/$id" \
    "$SWEEP_HOME/Library/Application Support/$id" \
    "$SWEEP_HOME/Library/Logs/$id" \
    "$SWEEP_HOME/Library/Containers/$id"
  do
    [[ -e "$p" || -L "$p" ]] || continue
    case "$(basename "$p")" in
      "$id"|"$id.plist"|"$id.savedState") printf '%s\n' "$p" ;;
    esac
  done
}

pref_paths() {
  local id="$1" p
  p="$SWEEP_HOME/Library/Preferences/$id.plist"
  [[ -f "$p" && ! -L "$p" ]] || return 0
  printf '%s\n' "$p"
}

state_paths() {
  local id="$1" p
  p="$SWEEP_HOME/Library/Saved Application State/$id.savedState"
  [[ -e "$p" && ! -L "$p" ]] || return 0
  printf '%s\n' "$p"
}

shared_paths() {
  local id="$1" vendor dir path base low
  vendor="$(printf '%s' "$id" | awk -F. 'length($2) >= 4 { print tolower($2) }')"
  for dir in \
    "$SWEEP_HOME/Library/Group Containers" \
    "$SWEEP_HOME/Library/Application Support" \
    "$SWEEP_HOME/Library/Containers" \
    "$SWEEP_HOME/Library/Caches" \
    "$SWEEP_HOME/Library/Logs"
  do
    [[ -d "$dir" && ! -L "$dir" ]] || continue
    for path in "$dir"/*; do
      [[ -e "$path" && ! -L "$path" ]] || continue
      base="$(basename "$path")"
      [[ "$base" == "$id" || "$base" == "$id.plist" || "$base" == "$id.savedState" ]] && continue
      case "$base" in
        "$id".*|"group.$id"|"group.$id".*|*.$id|*.$id.*)
          printf '%s\n' "$path"
          continue
          ;;
      esac
      if [[ -n "$vendor" ]]; then
        low="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
        [[ "$low" == "$vendor" ]] && printf '%s\n' "$path"
      fi
    done
  done
}

cmd_uninstall_restore() {
  local name="$1" trash root app
  [[ -n "$name" ]] || die "Name the app. Example: sweep uninstall restore Widget"
  trash="$SWEEP_HOME/.Trash/$name.app"
  [[ -d "$trash" ]] || die "$name is not in the Trash."
  while IFS= read -r app; do
    if [[ "$(basename "$app" .app)" == "$name" ]]; then
      die "$name is already installed."
    fi
  done < <(each_app)
  root="$(app_search_roots | awk 'NR==1 { print; exit }')"
  [[ -n "$root" ]] || die "No application folder to restore into."
  mkdir -p "$root"
  mv "$trash" "$root/$name.app"
  printf '  Restored %s\n' "${root#"$SWEEP_HOME"/}/$name.app"
}

cmd_uninstall() {
  local name="$1" mode="${2:-}" app id copies p
  if [[ "$name" == "restore" ]]; then
    cmd_uninstall_restore "$mode"
    return
  fi
  if [[ -z "$name" ]]; then
    printf 'Installed apps. Nothing is moved until you pass --yes.\n'
    while IFS= read -r app; do
      id="$(bundle_id_of "$app" || true)"
      printf '  %s\n    %s\n    %s\n' "$(basename "$app" .app)" "${id:-no bundle id}" "$(human "$(kb_of "$app")")"
    done < <(each_app)
    printf '\n  sweep uninstall Name --yes    moves that app to the Trash\n'
    printf '  Leftovers are listed and kept unless you also pass --leftovers.\n'
    return 0
  fi
  app=""
  while IFS= read -r p; do
    if [[ "$(basename "$p" .app)" == "$name" ]]; then
      app="$p"
      break
    fi
  done < <(each_app)
  [[ -n "$app" ]] || die "No app named $name in the application folders."
  id="$(bundle_id_of "$app" || true)"
  [[ -n "$id" ]] || die "$name has no bundle id. Sweep will not guess leftovers."
  copies="$(app_copies "$id")"
  if [[ "$mode" != "move" ]]; then
  printf '  %s\n' "$(basename "$app")"
  printf '  %s\n' "$id"
  printf '  team %s\n' "$(team_id_of "$app" || printf 'none')"
  printf '  %s\n' "${app#"$SWEEP_HOME"/}"
  printf '  %s. The app is moved to the Trash, not deleted for good.\n' "$(human "$(kb_of "$app")")"
  printf '  Leftover search stays inside your home folder. Full Disk Access is not required.\n'
  printf '  Package receipts, shown only, never used as a delete list:\n'
  local receipt any_receipt=0
  while IFS= read -r receipt; do
    [[ -n "$receipt" ]] || continue
    any_receipt=1
    printf '    %s\n' "$receipt"
  done < <(receipts_for "$id")
  [[ "$any_receipt" -eq 1 ]] || printf '    none\n'
  if app_is_open "$app"; then
    printf '  This app is open. Quit it before removing it.\n'
  fi
  printf '  Leftovers with this exact bundle id:\n'
  local any=0 saw_container=0
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    any=1
    printf '    %s    %s\n' "$(human "$(kb_of "$p")")" "${p#"$SWEEP_HOME"/}"
    [[ "$p" == *"/Containers/"* ]] && saw_container=1
  done < <(leftover_paths "$id")
  [[ "$any" -eq 1 ]] || printf '    none\n'
  if [[ "$saw_container" -eq 1 ]]; then
    printf '  A container can hold that app'\''s own files. It stays until you pass --leftovers.\n'
  fi
  printf '  Preference file, shown only:\n'
  local pref any_pref=0
  while IFS= read -r pref; do
    [[ -n "$pref" ]] || continue
    any_pref=1
    printf '    %s    %s\n' "$(human "$(kb_of "$pref")")" "${pref#"$SWEEP_HOME"/}"
  done < <(pref_paths "$id")
  [[ "$any_pref" -eq 1 ]] || printf '    none\n'
  printf '  Saved application state, shown only:\n'
  local state any_state=0
  while IFS= read -r state; do
    [[ -n "$state" ]] || continue
    any_state=1
    printf '    %s    %s\n' "$(human "$(kb_of "$state")")" "${state#"$SWEEP_HOME"/}"
  done < <(state_paths "$id")
  [[ "$any_state" -eq 1 ]] || printf '    none\n'
  printf '  Shared folders, shown only, never a delete list:\n'
  local shared any_shared=0
  while IFS= read -r shared; do
    [[ -n "$shared" ]] || continue
    any_shared=1
    printf '    %s    %s\n' "$(human "$(kb_of "$shared")")" "${shared#"$SWEEP_HOME"/}"
  done < <(shared_paths "$id")
  [[ "$any_shared" -eq 1 ]] || printf '    none\n'
  fi
  if [[ "$DRY" -eq 1 ]]; then
    printf '  Nothing was moved. Pass --yes to move the app to the Trash.\n'
    return 0
  fi
  if app_is_open "$app"; then
    die "$name is open. Quit it, then run this again."
  fi
  if [[ "${copies:-0}" -gt 1 ]]; then
    die "Another copy of $id is installed. Sweep will not remove one of them."
  fi
  mkdir -p "$SWEEP_HOME/.Trash"
  local dest
  dest="$SWEEP_HOME/.Trash/$(basename "$app")"
  if [[ -e "$dest" ]]; then
    dest="$SWEEP_HOME/.Trash/$(basename "$app" .app)-$(date '+%H%M%S').app"
  fi
  remember_removal "$(kb_of "$app")" "$(basename "$app" .app)" "$dest"
  mv "$app" "$dest"
  printf '  Moved to the Trash: %s\n' "${dest#"$SWEEP_HOME"/}"
  printf '  While it is still there: sweep uninstall restore %s\n' "$name"
  if [[ "$UNINSTALL_LEFTOVERS" -eq 1 ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      remember_removal "$(kb_of "$p")" "$(basename "$p")" "$p"
      rm -rf "$p"
      printf '  Removed %s\n' "${p#"$SWEEP_HOME"/}"
    done < <(leftover_paths "$id")
  else
    printf '  Leftovers were kept. They stay unticked. orphans lists them after 30 days.\n'
  fi
}

path_age_days() {
  python3 -c 'import os,sys,time
print(int((time.time()-os.stat(sys.argv[1]).st_mtime)/86400))' "$1"
}

bundle_name_ok() {
  local name="$1" dots
  [[ "$name" == com.apple.* ]] && return 1
  dots="$(printf '%s' "$name" | awk -F. '{print NF-1}')"
  [[ "${dots:-0}" -ge 2 ]]
}

installed_ids() {
  local app id
  while IFS= read -r app; do
    id="$(bundle_id_of "$app" || true)"
    if [[ -n "$id" ]]; then
      printf '%s\n' "$id"
    fi
  done < <(each_app)
}

id_is_installed() {
  local id="$1" ids="$2" line
  while IFS= read -r line; do
    [[ "$line" == "$id" ]] && return 0
  done <<< "$ids"
  return 1
}

each_orphan() {
  local base dir path id ids
  ids="$(installed_ids)"
  for base in Caches "Application Support" Containers Logs; do
    dir="$SWEEP_HOME/Library/$base"
    [[ -d "$dir" ]] || continue
    for path in "$dir"/*; do
      [[ -d "$path" && ! -L "$path" ]] || continue
      id="$(basename "$path")"
      bundle_name_ok "$id" || continue
      if id_is_installed "$id" "$ids"; then
        continue
      fi
      [[ "$(path_age_days "$path")" -ge 30 ]] || continue
      printf '%s\n' "$path"
    done
  done
  dir="$SWEEP_HOME/Library/Group Containers"
  if [[ -d "$dir" && ! -L "$dir" ]]; then
    for path in "$dir"/*; do
      [[ -d "$path" && ! -L "$path" ]] || continue
      id="$(container_bundle_id "$(basename "$path")" || true)"
      [[ -n "$id" ]] || continue
      bundle_name_ok "$id" || continue
      if id_is_installed "$id" "$ids"; then
        continue
      fi
      [[ "$(path_age_days "$path")" -ge 30 ]] || continue
      printf '%s\n' "$path"
    done
  fi
}

container_bundle_id() {
  local name="$1" rest
  name="${name#group.}"
  case "$name" in
    com.*|org.*|net.*|io.*)
      printf '%s' "$name"
      return 0
      ;;
  esac
  rest="${name#*.}"
  [[ "$rest" == "$name" ]] && return 1
  case "$rest" in
    com.*|org.*|net.*|io.*)
      printf '%s' "$rest"
      return 0
      ;;
  esac
  return 1
}

orphan_still() {
  local want="$1" path
  under "$SWEEP_HOME" "$want" || return 1
  [[ -d "$want" && ! -L "$want" ]] || return 1
  while IFS= read -r path; do
    [[ "$path" == "$want" ]] && return 0
  done < <(each_orphan)
  return 1
}

cmd_orphans() {
  local action="${1:-}" target="${2:-}" path id embedded found=0
  printf 'Leftovers whose app is gone, unused for 30 days.\n'
  printf '  Newer leftovers stay hidden. Nothing is selected.\n'
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    found=1
    id="$(basename "$path")"
    embedded="$(container_bundle_id "$id" || true)"
    printf '  %s    %s\n' "$(human "$(kb_of "$path")")" "${path#"$SWEEP_HOME"/}"
    if [[ "$action" == "remove" && ( "$target" == "$id" || ( -n "$embedded" && "$target" == "$embedded" ) ) && "$DRY" -eq 0 ]]; then
      remember_removal "$(kb_of "$path")" "$id" "$path"
      rm -rf "$path"
      printf '    Removed. It had been unused for 30 days and no app owns it.\n'
    elif [[ "$action" == "remove" && ( "$target" == "$id" || ( -n "$embedded" && "$target" == "$embedded" ) ) ]]; then
      printf '    Pass --yes to remove it. This is permanent.\n'
    fi
  done < <(each_orphan)
  [[ "$found" -eq 1 ]] || printf '  None.\n'
}

each_other_login() {
  local out pid i
  if [[ -n "${SWEEP_TEST:-}" ]]; then
    if [[ -n "${SWEEP_BTM_LIST:-}" && -f "$SWEEP_BTM_LIST" ]]; then
      cat "$SWEEP_BTM_LIST"
    fi
    return 0
  fi
  real_machine || return 0
  command -v sfltool >/dev/null 2>&1 || return 0
  out="$(mktemp)"
  sfltool dumpbtm >"$out" 2>/dev/null &
  pid=$!
  i=0
  while kill -0 "$pid" 2>/dev/null; do
    i=$((i + 1))
    if [[ "$i" -gt 20 ]]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      rm -f "$out"
      return 0
    fi
    sleep 0.25
  done
  wait "$pid" 2>/dev/null || true
  awk '
    /Name:/ {
      sub(/^.*Name:[[:space:]]*/, "")
      if ($0 != "") print
    }
  ' "$out" | awk '!seen[$0]++'
  rm -f "$out"
}

show_other_logins() {
  local name any
  any=0
  printf '  Other login items, shown only. Nothing here is selected or removed.\n'
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    any=1
    printf '    %s\n' "$name"
  done < <(each_other_login)
  if [[ "$any" -eq 0 ]]; then
    printf '    none\n'
  fi
}

cmd_login() {
  local plist prog base action target
  action="${1:-}"
  target="${2:-}"
  printf 'Login items\n'
  printf '  A helper that still exists is left alone.\n'
  printf '  Everything Apple protects is in System Settings → General → Login Items & Extensions.\n'
  if [[ ! -d "$SWEEP_HOME/Library/LaunchAgents" ]]; then
    printf '  No user login helpers.\n'
    show_other_logins
    return 0
  fi
  local found=0
  for plist in "$SWEEP_HOME/Library/LaunchAgents"/*.plist; do
    [[ -f "$plist" ]] || continue
    prog="$(launch_program "$plist")"
    [[ -n "$prog" ]] || continue
    base="$(basename "$plist")"
    if [[ -e "$prog" ]]; then
      continue
    fi
    found=1
    printf '  %s\n    missing %s\n' "$base" "$prog"
    if [[ "$action" == "remove" && "$target" == "$base" ]]; then
      if [[ "$DRY" -eq 1 ]]; then
        printf '    Pass --yes to remove this helper. The missing program is not restored.\n'
      else
        remember_removal "$(kb_of "$plist")" "$base" "$plist"
        rm -f "$plist"
        printf '    Removed. It pointed at a program that was already gone.\n'
      fi
    fi
  done
  [[ "$found" -eq 1 ]] || printf '  No user login helpers with a missing program.\n'
  if [[ "$action" == "remove" && "$found" -eq 1 && "$DRY" -eq 1 ]]; then
    :
  elif [[ "$action" == "remove" && "$DRY" -eq 0 ]]; then
    local removed=0
    [[ -f "$SWEEP_HOME/Library/LaunchAgents/$target" ]] && removed=1
    [[ "$removed" -eq 0 ]] || die "Left $target in place. It is not a missing-program helper."
  fi
  show_other_logins
}

cmd_last() {
  local file all="${1:-}"
  file="$(receipt_file)"
  if [[ ! -f "$file" ]]; then
    printf 'Nothing has been removed yet.\n'
    return 0
  fi
  printf 'Removed:\n'
  if [[ "$all" == "all" ]]; then
    cat "$file"
  else
    tail -n 20 "$file"
  fi
  printf '\n'
}

delete_item() {
  local how="$1" path="$2" kb name
  case "$how" in
    simulators|orphan|homebrew) ;;
    docker) remember_removal "$(docker_kb)" "Docker unused data" ;;
    *)
      if [[ -e "$path" || -L "$path" ]]; then
        kb="$(kb_of "$path")"
        name="$(pretty_label "$(basename "$path")" "$path")"
        remember_removal "$kb" "$name" "$path"
      fi
      ;;
  esac
  case "$how" in
    path) remove_one "$(dirname "$path")" "$path" ;;
    orphan)
      orphan_still "$path" || die "refusing to touch $path"
      remember_removal "$(kb_of "$path")" "$(pretty_label "$(basename "$path")" "$path")" "$path"
      rm -rf "$path"
      ;;
    app) delete_app_cache "$path" ;;
    logs) clean_old_logs_under "$path" ;;
    trash) remove_one "$SWEEP_HOME/.Trash" "$path" ;;
    backup) delete_backup_child "$path" ;;
    homebrew)
      clean_homebrew
      ;;
    simulators)
      real_machine || return 0
      command -v xcrun >/dev/null 2>&1 || return 0
      xcrun simctl delete unavailable >/dev/null 2>&1 || true
      ;;
    simone)
      local udid="${path#sim:}"
      [[ -n "$udid" && "$udid" != "$path" ]] || die "refusing to touch $path"
      if [[ -n "${SWEEP_TEST:-}" ]]; then
        printf '%s\n' "$udid" >>"$SWEEP_HOME/sim.deleted"
        return 0
      fi
      real_machine || return 0
      command -v xcrun >/dev/null 2>&1 || return 0
      xcrun simctl delete "$udid" >/dev/null 2>&1 || true
      ;;
    docker)
      docker_up || return 0
      docker system prune -f >/dev/null 2>&1 || true
      ;;
    *) die "refusing to touch $path" ;;
  esac
}

only_has() {
  local name="$1" line
  [[ -n "$ONLY" ]] || return 1
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    [[ "$line" == "$name" ]] && return 0
  done <<< "$ONLY"
  return 1
}

cmd_items() {
  local group kb label path how any
  group="${PICKS%% *}"
  [[ -n "$group" ]] || die "Name a group. Example: sweep items caches"
  known_group "$group" || die "unknown group: $group"
  any=0
  while IFS=$'\t' read -r kb plain label path how; do
    [[ -n "$label" ]] || continue
    if [[ "$plain" == "$label" ]]; then
      printf '  %10s    %s\n' "$(human "$kb")" "$plain"
    else
      printf '  %10s    %s    %s%s%s\n' "$(human "$kb")" "$plain" "$D" "$label" "$Z"
    fi
    any=1
  done < <(sorted_items "$group")
  [[ "$any" -eq 1 ]] || printf '  Nothing in %s.\n' "$group"
}

name_matches() {
  local want="$1" plain="$2" label="$3" base="$4"
  only_has "$plain" || only_has "$label" || only_has "$base" || only_has "$want"
}

cmd_clean_only() {
  local group kb plain label path how base matched sum
  [[ -n "$PICKS" ]] || die "Name a group. Example: sweep clean caches --only Spotify --yes"
  for group in $PICKS; do
    known_group "$group" || die "unknown group: $group"
  done
  matched=0
  sum=0
  for group in $PICKS; do
    while IFS=$'\t' read -r kb plain label path how; do
      [[ -n "$label" ]] || continue
      base="$(basename "$path")"
      if name_matches "$plain" "$plain" "$label" "$base"; then
        printf '  %10s    %s\n' "$(human "$kb")" "$plain"
        sum=$((sum + kb))
        matched=1
      fi
    done < <(sorted_items "$group")
  done
  if [[ "$matched" -eq 0 ]]; then
    die "No folder with that name. Run: sweep items ${PICKS%% *}"
  fi
  if [[ "$DRY" -eq 1 ]]; then
    printf '  Would remove about %s. Pass --yes to delete it.\n' "$(human "$sum")"
    return 0
  fi
  for group in $PICKS; do
    while IFS=$'\t' read -r kb plain label path how; do
      [[ -n "$label" ]] || continue
      base="$(basename "$path")"
      if name_matches "$plain" "$plain" "$label" "$base"; then
        delete_item "$how" "$path"
      fi
    done < <(sorted_items "$group")
  done
  printf '  Freed about %s.\n' "$(human "$sum")"
}

MENU_DIR=""
SCREEN="home"
GROUP=""
NOTE=""
AUTO_MENU=0
PAGE=1
FILTER=""
PAGE_SIZE=12
SHOW_HELP=0
SHOW_SMALL=0

menu_blank() {
  if [[ -t 1 ]]; then
    printf '\033[H\033[2J'
  fi
}

path_selected() {
  [[ -f "$MENU_DIR/selpaths" ]] || return 1
  grep -F -x -q -- "$1" "$MENU_DIR/selpaths"
}

toggle_path() {
  local path="$1" next
  next="$MENU_DIR/selpaths.next"
  if path_selected "$path"; then
    grep -F -x -v -- "$path" "$MENU_DIR/selpaths" >"$next" || true
    mv "$next" "$MENU_DIR/selpaths"
  else
    printf '%s\n' "$path" >>"$MENU_DIR/selpaths"
  fi
}

fold_case() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

text_has() {
  local hay needle
  hay="$(fold_case "$1")"
  needle="$(fold_case "$2")"
  [[ -n "$needle" && "$hay" == *"$needle"* ]]
}

forget_catalog() {
  rm -f "$MENU_DIR/catalog"
}

ensure_catalog() {
  local group kb plain label path how ids base group_name i n
  [[ -f "$MENU_DIR/catalog" ]] && return 0
  : >"$MENU_DIR/catalog.tmp"
  ids="$(installed_ids)"
  n=0
  for group in $DEFAULT_GROUPS $OPTIONAL_GROUPS; do
    n=$((n + 1))
  done
  i=0
  for group in $DEFAULT_GROUPS $OPTIONAL_GROUPS; do
    i=$((i + 1))
    status "Measuring $i of $n: $group"
    while IFS=$'\t' read -r kb plain label path how; do
      [[ -n "$path" ]] || continue
      group_name="$group"
      if [[ "$group" == "caches" ]]; then
        base="$(basename "$path")"
        if cache_is_gone "$base" "$ids"; then
          group_name="gone"
        fi
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$kb" "$plain" "$label" "$path" "$how" "$group_name" >>"$MENU_DIR/catalog.tmp"
    done < <(sorted_items "$group")
  done
  status "Measuring leftovers"
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    catalog_has_path "$path" && continue
    kb="$(kb_of "$path")"
    [[ "${kb:-0}" -gt 0 ]] || continue
    plain="$(pretty_label "$(basename "$path")" "$path")"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$kb" "$plain" "$(basename "$path")" "$path" orphan orphans >>"$MENU_DIR/catalog.tmp"
  done < <(each_orphan)
  clear_status
  sort -nr "$MENU_DIR/catalog.tmp" >"$MENU_DIR/catalog"
  rm -f "$MENU_DIR/catalog.tmp"
}

catalog_has_path() {
  local want="$1" kb plain label path how group
  [[ -s "$MENU_DIR/catalog.tmp" ]] || return 1
  while IFS=$'\t' read -r kb plain label path how group; do
    [[ "$path" == "$want" ]] && return 0
  done <"$MENU_DIR/catalog.tmp"
  return 1
}

care_word() {
  [[ "$1" == "orphans" || "$1" == "gone" ]] && { printf 'ask first'; return; }
  case " $OPTIONAL_GROUPS " in
    *" $1 "*) printf 'ask first' ;;
    *) printf 'safe' ;;
  esac
}

owner_process() {
  case "$1" in
    *com.spotify.client*|*"/Spotify/"*) printf 'Spotify' ;;
    *Google/Chrome*) printf 'Google Chrome' ;;
    *com.apple.Safari*) printf 'Safari' ;;
    *Firefox*) printf 'firefox' ;;
    *Slack*) printf 'Slack' ;;
    *discord*|*Discord*) printf 'Discord' ;;
    *"/Code/"*) printf 'Code' ;;
    *Cursor*) printf 'Cursor' ;;
    *DerivedData*|*com.apple.dt.Xcode*) printf 'Xcode' ;;
    *Figma*) printf 'Figma' ;;
    *) return 1 ;;
  esac
}

executable_of() {
  local plist="$1/Contents/Info.plist"
  [[ -f "$plist" ]] || return 1
  python3 -c 'import plistlib,sys
try:
    p=plistlib.load(open(sys.argv[1],"rb"))
except Exception:
    sys.exit(1)
exe=p.get("CFBundleExecutable") or ""
if not exe:
    sys.exit(1)
print(exe)' "$plist"
}

app_with_id() {
  local want="$1" app id
  while IFS= read -r app; do
    id="$(bundle_id_of "$app" || true)"
    if [[ "$id" == "$want" ]]; then
      printf '%s' "$app"
      return 0
    fi
  done < <(each_app)
  return 1
}

app_is_open() {
  local proc id app exe
  command -v pgrep >/dev/null 2>&1 || return 1
  proc="$(owner_process "$1" || true)"
  if [[ -n "$proc" ]] && pgrep -x "$proc" >/dev/null 2>&1; then
    return 0
  fi
  id="$(basename "$1")"
  bundle_name_ok "$id" || return 1
  app="$(app_with_id "$id" || true)"
  [[ -n "$app" ]] || return 1
  exe="$(executable_of "$app" || true)"
  [[ -n "$exe" ]] || return 1
  pgrep -x "$exe" >/dev/null 2>&1
}

menu_note() {
  if [[ -n "$NOTE" ]]; then
    printf '\n  %s\n' "$NOTE"
    NOTE=""
  fi
}

menu_draw_home() {
  local kb plain label path how group n shown mark ticked sum care start end total
  local hidden safe_sum carec markc
  menu_blank
  print_disk
  menu_note
  ensure_catalog
  printf '\n  %sBiggest folders%s\n' "$B" "$Z"
  if [[ -n "$FILTER" ]]; then
    printf '  Showing names that match "%s". Type show for the full list.\n' "$FILTER"
  fi
  : >"$MENU_DIR/items"
  n=0
  ticked=0
  sum=0
  total=0
  hidden=0
  safe_sum=0
  while IFS=$'\t' read -r kb plain label path how group; do
    [[ -n "$path" ]] || continue
    if [[ -n "$FILTER" ]] && ! text_has "$plain $label" "$FILTER"; then
      continue
    fi
    if [[ "$SHOW_SMALL" -eq 0 && "$kb" -lt "$MIN_KB" ]]; then
      hidden=$((hidden + 1))
      continue
    fi
    if [[ "$(care_word "$group")" == "safe" ]]; then
      safe_sum=$((safe_sum + kb))
    fi
    total=$((total + 1))
    n=$((n + 1))
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$kb" "$plain" "$label" "$path" "$how" "$group" >>"$MENU_DIR/items"
    if path_selected "$path"; then
      ticked=$((ticked + 1))
      sum=$((sum + kb))
    fi
  done <"$MENU_DIR/catalog"
  if [[ "$safe_sum" -gt 0 ]]; then
    printf '  Safe folders here: %s. Type go, then yes.\n' "$(human "$safe_sum")"
  fi
  if [[ "$SHOW_SMALL" -eq 0 && "$hidden" -gt 0 ]]; then
    printf '  %s smaller folders are hidden. Type small to see them.\n' "$hidden"
  elif [[ "$SHOW_SMALL" -eq 1 && "$MIN_KB" -gt 0 ]]; then
    printf '  Showing smaller folders too. Type small to hide them.\n'
  fi
  start=$(((PAGE - 1) * PAGE_SIZE + 1))
  end=$((PAGE * PAGE_SIZE))
  if [[ "$total" -eq 0 ]]; then
    printf '\n  Nothing to clean.\n'
  else
    shown=0
    while IFS=$'\t' read -r n kb plain label path how group; do
      [[ "$n" -ge "$start" && "$n" -le "$end" ]] || continue
      shown=1
      if path_selected "$path"; then
        mark="[x]"
      else
        mark="[ ]"
      fi
      care="$(care_word "$group")"
      if app_is_open "$path"; then
        care="app open"
      elif [[ "$care" == "ask first" && "$(fate_word "$group")" == "stays" ]]; then
        care="stays"
      elif [[ "$care" != "ask first" ]]; then
        care="$(fate_word "$group")"
      fi
      if [[ "$care" == "ask first" || "$care" == "app open" ]]; then
        carec="$Y"
      elif [[ "$care" == "stays" && "$(care_word "$group")" == "ask first" ]]; then
        carec="$Y"
      else
        carec="$G"
      fi
      if [[ "$mark" == "[x]" ]]; then
        markc="$G"
      else
        markc="$Z"
      fi
      printf '  %s%s%s %2d  %10s   %s  %s%s%s\n' \
        "$markc" "$mark" "$Z" "$n" "$(human "$kb")" "$plain" "$carec" "$care" "$Z"
    done <"$MENU_DIR/items"
    [[ "$shown" -eq 1 ]] || printf '\n  No more lines on this page. Type prev.\n'
  fi
  if [[ "$ticked" -gt 0 ]]; then
    printf '\n  %sTicked: %s, about %s.%s\n' "$G" "$ticked" "$(human "$sum")" "$Z"
    printf '  Type clean, then yes.\n'
  elif [[ "$total" -gt 0 && -z "$FILTER" ]]; then
    printf '\n  Type 1 to tick the first line, or walk to go one by one.\n'
  fi
  if [[ "$total" -gt "$PAGE_SIZE" ]]; then
    printf '\n  Page %s. Type more or prev.\n' "$PAGE"
  fi
  if [[ "$SHOW_HELP" -eq 1 ]]; then
    cat <<EOF

  walk     one folder at a time. yes deletes it, no keeps it
  1 3      tick those lines          Spotify   tick the line named Spotify
  clean    delete ticked lines, after you type yes
  all      tick the safe lines       none      untick every line
  caches   open one list, also: dev trash browsers backups
  more     next page                 find music   only matching names
  safe     delete the usual caches, after you type yes
  info 1   show where line 1 lives
  last     what sweep already removed
  orphans  leftovers unused for 30 days. Nothing is selected
  quit     leave

EOF
  else
    cat <<EOF

  go       remove safe folders, except apps that are still open
  walk     yes or no, one folder at a time
  clean    delete what you ticked, then type yes
  help     more commands
  quit     leave

EOF
  fi
}

